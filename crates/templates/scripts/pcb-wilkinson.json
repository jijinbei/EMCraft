  {"id": "a1", "net": "S", "layer": "F.Cu", "start": ["=l_feed", 0], "end": ["=l_feed", "=rise"], "width": "=w_q"},
  {"id": "a2", "net": "S", "layer": "F.Cu", "start": ["=l_feed", "=rise"], "end": ["=l_feed + run", "=rise"], "width": "=w_q"},
