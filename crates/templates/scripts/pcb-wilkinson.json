[
 {"command": "project.variable", "params": {"name": "er", "label": "relative permittivity", "value": 3.55}},
 {"command": "project.variable", "params": {"name": "h", "label": "substrate thickness", "value": 0.508, "quantity": "length"}},
 {"command": "project.variable", "params": {"name": "w", "label": "line width", "value": 1.1, "quantity": "length"}},
 {"command": "project.variable", "params": {"name": "w_q", "label": "arm width", "value": 0.6, "quantity": "length"}},
