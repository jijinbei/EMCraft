  {"id": "b3", "net": "S", "layer": "F.Cu", "start": ["=l_feed + run", "=-rise"], "end": ["=l_feed + run", "=-half_gap"], "width": "=w_q"},
  {"id": "p2", "net": "S", "layer": "F.Cu", "start": ["=l_feed + run", "=half_gap"], "end": ["=2*l_feed + run", "=half_gap"], "width": "=w"},
  {"id": "p3", "net": "S", "layer": "F.Cu", "start": ["=l_feed + run", "=-half_gap"], "end": ["=2*l_feed + run", "=-half_gap"], "width": "=w"}], "copper": []}}},
 {"command": "pcb.region", "params": {"lo": [-2, "=-rise - 5"], "hi": ["=2*l_feed + run + 2", "=rise + 5"], "above": 5, "below": 0}},
