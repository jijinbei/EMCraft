[
 {"command": "project.variable", "params": {"name": "arm", "label": "arm length", "value": 7.0, "quantity": "length"}},
 {"command": "project.variable", "params": {"name": "gap", "label": "feed gap", "value": 1.0, "quantity": "length"}},
 {"command": "project.variable", "params": {"name": "r_wire", "label": "wire radius", "value": 0.5, "quantity": "length"}},
 {"command": "geometry.import", "params": {"path": "template:halfwave-dipole.solidcraft", "parameters": {"arm": "=arm", "gap": "=gap", "r_wire": "=r_wire"}, "open": true, "box": [60, 60, 60], "thickness": 15}},
 {"command": "mesh.generate", "params": {"per_wavelength": 4, "frequency": 10}},
 {"command": "model.port.lumped", "params": {"name": "feed", "from": [30.0, 30.0, "=30 - gap/2"], "to": [30.0, 30.0, "=30 + gap/2"], "impedance": 73, "radius": "=0.8*r_wire"}},
 {"command": "project.setup", "params": {"kind": "radiation", "frequency": 10}},
 {"command": "solve.radiation", "params": {"frequency": 10}}
