 {"command": "circuit.cascade", "params": {"name": "receiver", "blocks": [{"type": "amplifier", "gain": "=lna_gain", "noise_figure": "=lna_nf"}, {"type": "data", "data": "filter"}, {"type": "amplifier", "gain": "=rx_gain", "noise_figure": "=rx_nf"}], "source": "antenna", "bandwidth": "=bw", "snr": 10}},
