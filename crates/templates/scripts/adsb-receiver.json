 {"command": "pcb.load", "params": {"data": {"name": "ADS-B band-pass filter", "layers": [{"name": "F.Cu", "z": 0, "eps_below": "=er", "loss_below": "=tan_d", "copper": 0.035}, {"name": "B.Cu", "z": "=h", "eps_below": 1}], "segments": [
   {"id": "in", "net": "S", "layer": "F.Cu", "start": [0, 0], "end": [10, 0], "width": "=w"},
   {"id": "r1", "net": "S", "layer": "F.Cu", "start": ["=10 + gap", 0], "end": ["=10 + l1", 0], "width": "=w"},
   {"id": "r2", "net": "S", "layer": "F.Cu", "start": ["=10 + l1 + gap", 0], "end": ["=10 + l1 + l2", 0], "width": "=w"},
   {"id": "r3", "net": "S", "layer": "F.Cu", "start": ["=10 + l1 + l2 + gap", 0], "end": ["=10 + 2*l1 + l2", 0], "width": "=w"},
   {"id": "out", "net": "S", "layer": "F.Cu", "start": ["=10 + 2*l1 + l2 + gap", 0], "end": ["=20 + 2*l1 + l2 + gap", 0], "width": "=w"}], "copper": []}}},
 {"command": "pcb.region", "params": {"lo": [-2, -15], "hi": ["=22 + 2*l1 + l2 + gap", 15], "above": 15, "below": 0}},
