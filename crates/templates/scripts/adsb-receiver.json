 {"command": "pcb.port", "params": {"name": "1", "segment": "in", "end": "start"}},
 {"command": "pcb.port", "params": {"name": "2", "segment": "out", "end": "end"}},
 {"command": "pcb.element", "params": {"name": "C1", "layer": "F.Cu", "from": [10, 0], "to": ["=10 + gap", 0], "capacitance": "=c1", "width": "=w"}},
 {"command": "pcb.element", "params": {"name": "C2", "layer": "F.Cu", "from": ["=10 + l1", 0], "to": ["=10 + l1 + gap", 0], "capacitance": "=c2", "width": "=w"}},
 {"command": "pcb.element", "params": {"name": "C3", "layer": "F.Cu", "from": ["=10 + l1 + l2", 0], "to": ["=10 + l1 + l2 + gap", 0], "capacitance": "=c2", "width": "=w"}},
 {"command": "pcb.element", "params": {"name": "C4", "layer": "F.Cu", "from": ["=10 + 2*l1 + l2", 0], "to": ["=10 + 2*l1 + l2 + gap", 0], "capacitance": "=c1", "width": "=w"}},
 {"command": "mesh.generate", "params": {"size": 4, "strip_edge": 0.25}},
