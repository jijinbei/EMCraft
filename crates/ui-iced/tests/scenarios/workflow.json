[
  {"note": "The workflow: a new project's Run refused with the steps that block it marked; the high-pass filter's Setup changed (the run then waits), refused while a field is wrong, confirmed, run from step 6, its results' step opened and checked"},
  {"call": "engine.execute", "params": {"command": "file.new", "params": {}}},
  {"click": "step:run"},
  {"expect": {"inspect": {"workflow.step": "run", "tab": "*"}}},
  {"click": "run:start"},
  {"expect": {"inspect": {"workflow.refused": "*", "workflow.steps.geometry": "missing", "job": null}}},
  {"call": "engine.execute", "params": {"command": "file.sample", "params": {"name": "highpass"}}},
  {"expect": {"inspect": {"workflow.steps.run": "todo", "workflow.refused": null, "workflow.step": null}}},
  {"click": "step:setup"},
  {"expect": {"inspect": {"workflow.step": "setup", "workflow.confirmed": true}}},
  {"call": "ui.set", "params": {"setup": {"stop": "five"}}},
  {"expect": {"inspect": {"workflow.confirmed": false, "workflow.steps.run": "waiting"}}},
  {"click": "setup:confirm"},
  {"expect": {"inspect": {"workflow.errors.stop": "*", "workflow.confirmed": false}}},
  {"call": "ui.set", "params": {"setup": {"stop": "9", "points": "5"}}},
  {"click": "setup:confirm"},
  {"expect": {"inspect": {"workflow.confirmed": true, "workflow.setup.points": "5"}}},
  {"click": "step:run"},
  {"click": "run:start"},
  {"until": {"inspect": {"job": null, "workflow.steps.run": "done"}}, "timeout": 120},
  {"expect": {"inspect": {"workflow.steps.results": "done", "workflow.failure": null, "workflow.step": "results"}}},
  {"click": "results:check"},
  {"expect": {"inspect": {"workflow.check.passive": true}}}
]
