[
  {"note": "Shapes come from SolidCraft (docs/adr/0010-geometry-from-solidcraft.md): a template opens its design, its shape set by the tree's Parameters; a design of the user's is a row with ↗ (Open in SolidCraft), its parameters rows of the Parameters; a port goes on a face by its name; the window makes no shapes"},
  {"call": "engine.execute", "params": {"command": "file.sample", "params": {"name": "h-bend"}}},
  {"note": "Its parameters are the template's; the names SolidCraft gives its dimensions (d1, …) are not rows"},
  {"expect": {"handles": ["row:variable:a", "row:variable:m", "add:geometry"], "hidden": ["row:design:template:h-bend.solidcraft:d1"]}},
  {"note": "Geometry's ＋: the import, a new design in SolidCraft, the background and new materials, no shape"},
  {"click": "add:geometry"},
  {"expect": {"inspect": {"adding": "geometry"}, "handles": ["new:design", "command:geometry.import", "command:model.material.create"],
              "hidden": ["command:geometry.solid", "command:geometry.body", "command:geometry.waveguide"]}},
  {"click": "add:geometry"},
  {"note": "The search leaves out the commands that make shapes; it finds the import"},
  {"call": "ui.set", "params": {"search": "geometry"}},
  {"expect": {"inspect": {"search.matches.0": "*"}}},
  {"call": "ui.set", "params": {"search": ""}},
  {"note": "A template's parameter set in the tree: the design evaluated again at it"},
  {"click": "row:variable:m"},
  {"expect": {"inspect": {"dialog.command": "project.variable", "dialog.fields.value.text": "14.6"}}},
  {"call": "ui.dialog", "params": {"set": {"value": "10"}}},
  {"click": "dialog:ok"},
  {"until": {"inspect": {"job": null}}, "timeout": 60},
  {"expect": {"inspect": {"error": null}}},
  {"shot": "designs-template"},
  {"note": "A design of the user's: its row opens it in SolidCraft, its parameters are rows"},
  {"call": "engine.execute", "params": {"command": "file.new"}},
  {"call": "engine.execute", "params": {"command": "geometry.import", "params": {"path": "../../tests/oracle/design-post/post.solidcraft", "materials": {"Body1": "interior"}}}},
  {"expect": {"handles": ["solidcraft:../../tests/oracle/design-post/post.solidcraft", "row:design:../../tests/oracle/design-post/post.solidcraft:d"],
              "hidden": ["row:design:../../tests/oracle/design-post/post.solidcraft:d1"]}},
  {"click": "row:design:../../tests/oracle/design-post/post.solidcraft:d"},
  {"expect": {"inspect": {"dialog.command": "geometry.design", "dialog.fields.name.text": "d"}}},
  {"call": "ui.dialog", "params": {"set": {"value": "4"}}},
  {"click": "dialog:ok"},
  {"until": {"inspect": {"job": null}}, "timeout": 60},
  {"expect": {"inspect": {"error": null}}},
  {"shot": "designs-own"},
  {"note": "A port on a face by its name: a name the design has none of is refused at its field, which lists the names it has"},
  {"call": "ui.dialog", "params": {"open": "model.port.create"}},
  {"expect": {"inspect": {"dialog.fields.face_name.text": ""}}},
  {"call": "ui.dialog", "params": {"set": {"name": "1", "face_name": "no such face"}}},
  {"click": "dialog:ok"},
  {"until": {"inspect": {"job": null}}, "timeout": 60},
  {"expect": {"inspect": {"dialog.command": "model.port.create", "dialog.fields.face_name.error": {"includes": "F1:-z"}}}},
  {"note": "The design's name for its face at z = 0: the port spans it"},
  {"call": "ui.dialog", "params": {"set": {"face_name": "F1:-z"}}},
  {"click": "dialog:ok"},
  {"until": {"inspect": {"job": null}}, "timeout": 60},
  {"expect": {"inspect": {"error": null, "dialog.fields.face_name.error": null}}},
  {"shot": "designs-port"}
]
