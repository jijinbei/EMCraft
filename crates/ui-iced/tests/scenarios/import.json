[
  {"note": "Importing a part: the geometry's step offers it; the dialog shows what can be imported, Choose file…, the file's bodies, size and parameters (each editable) and a line on what importing makes of it, its other fields folded under Options and its description behind ?"},
  {"call": "engine.execute", "params": {"command": "file.new"}},
  {"click": "step:geometry"},
  {"call": "ui.dialog", "params": {"open": "geometry.import"}},
  {"expect": {"inspect": {"dialog.command": "geometry.import", "dialog.options": false, "dialog.help": false, "dialog.detected": null},
              "handles": ["dialog:pick", "dialog:options", "dialog:help"]}},
  {"note": "A design's path: its body, size and parameters at once"},
  {"call": "ui.dialog", "params": {"set": {"path": "../../tests/oracle/design-post/post.solidcraft"}}},
  {"expect": {"inspect": {"dialog.detected.format": "solidcraft", "dialog.detected.units": "file",
                          "dialog.detected.size.0": [22.86, 1e-6], "dialog.detected.size.2": [30, 1e-6]}}},
  {"note": "A parameter changed in its row: written into the dialog's parameters, the design evaluated at it on import"},
  {"call": "ui.dialog", "params": {"parameters": {"d": "4"}}},
  {"expect": {"inspect": {"dialog.fields.parameters.text": "{\"d\":4.0}"}}},
  {"click": "dialog:options"},
  {"click": "dialog:help"},
  {"expect": {"inspect": {"dialog.options": true, "dialog.help": true}}},
  {"click": "dialog:options"},
  {"click": "dialog:help"},
  {"expect": {"inspect": {"dialog.options": false, "dialog.help": false}}},
  {"click": "dialog:ok"},
  {"until": {"inspect": {"job": null}}, "timeout": 60},
  {"expect": {"inspect": {"dialog": null, "error": null, "project.dirty": true}}},
  {"note": "A 3MF file dropped on the window opens the dialog on it; an empty drop is refused"},
  {"call": "ui.drop", "params": {"path": "../../tests/oracle/imported-post/post.3mf"}},
  {"expect": {"inspect": {"dialog.command": "geometry.import", "dialog.fields.path.text": "../../tests/oracle/imported-post/post.3mf", "dialog.detected.format": "3mf"}}},
  {"call": "ui.drop", "params": {"path": ""}, "fail": true},
  {"note": "A file that is not there says so in place; nothing is imported"},
  {"call": "ui.dialog", "params": {"set": {"path": "/no/such/part.3mf"}}},
  {"expect": {"inspect": {"dialog.detected.error": "*"}}},
  {"click": "dialog:cancel"},
  {"expect": {"inspect": {"dialog": null}}},
  {"note": "The start page's Import begins a new project with the import dialog open"},
  {"call": "ui.set", "params": {"start": true}},
  {"click": "home:import"},
  {"click": "ask:discard"},
  {"expect": {"inspect": {"dialog.command": "geometry.import", "dialog.fields.path.text": "", "start": false}}}
]
