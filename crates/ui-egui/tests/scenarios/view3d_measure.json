[
  {"note": "The ruler: two clicks in the 3D view, each snapped to a corner, an edge's middle, a face's centre, an edge or a face, measured by geometry.measure and drawn as a dimension with its Δx, Δy, Δz; Escape clears"},
  {"call": "engine.execute", "params": {"command": "geometry.solid", "params": {"shape": "box", "size": [20, 10, 30]}}},
  {"call": "ui.set", "params": {"view": "model", "step": "none", "standard_view": "front", "camera": {"projection": "orthographic"}}},
  {"frames": 2},
  {"click": "view3d:tool:measure"},
  {"expect": {"inspect": {"view3d.tools.tool": "measure"}}},
  {"note": "The middle of the view is the front face's centre"},
  {"move": "view3d"},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.tools.pointer.kind": "centre"}, "handles": ["view3d:snap", "view3d:corner:0", "view3d:corner:3"]}},
  {"shot": "measure-hover-centre"},
  {"click": "view3d"},
  {"expect": {"inspect": {"view3d.tools.picks.0.kind": "centre"}}},
  {"move": "view3d:corner:0"},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.tools.pointer.kind": "vertex"}}},
  {"click": "view3d:corner:0"},
  {"frames": 2},
  {"note": "From the face's centre to its corner: half its diagonal, 10 by 5"},
  {"expect": {"inspect": {"view3d.tools.measure.distance": [11.180339887, 1e-9], "view3d.tools.measure.delta.0": [-10, 1e-9], "view3d.tools.measure.unit": "mm", "view3d.tools.picks": []}, "handles": ["view3d:measure"], "status": "11.1803 mm"}},
  {"shot": "measure-corner"},
  {"note": "From the side: the top face (a plane), then the near bottom corner: the gap down to it, the box's height"},
  {"call": "ui.set", "params": {"standard_view": "iso"}},
  {"frames": 2},
  {"move": "view3d"},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.tools.pointer.kind": "face", "view3d.tools.pointer.at.1": [10, 1e-9]}}},
  {"click": "view3d"},
  {"expect": {"inspect": {"view3d.tools.measure": null, "view3d.tools.picks.0.kind": "face"}}},
  {"move": {"handle": "view3d", "offset": [-180, 100]}},
  {"frames": 2},
  {"move": "view3d:corner:0"},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.tools.pointer.kind": "vertex", "view3d.tools.pointer.at": [0.0, 0.0, 30.0]}}},
  {"click": "view3d:corner:0"},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.tools.measure.gap": [10, 1e-9], "view3d.tools.measure.angle": null}}},
  {"shot": "measure-gap"},
  {"note": "Escape clears the measurement, then turns the ruler off"},
  {"key": "Escape"},
  {"expect": {"inspect": {"view3d.tools.measure": null, "view3d.tools.tool": "measure"}, "hidden": ["view3d:measure"]}},
  {"key": "Escape"},
  {"expect": {"inspect": {"view3d.tools.tool": null}}},
  {"note": "Agents turn it on by name; a name that is no tool is refused"},
  {"call": "ui.set", "params": {"tool": "measure"}},
  {"expect": {"inspect": {"view3d.tools.tool": "measure"}}},
  {"call": "ui.set", "params": {"tool": "hammer"}, "fail": true},
  {"call": "ui.set", "params": {"tool": "none"}},
  {"expect": {"inspect": {"view3d.tools.tool": null}}}
]
