[
  {"note": "Where the far field is observed: a φ cut (θ varies) or a θ cut (φ varies) at an angle, the total or one polarization's share; the same through view.pattern"},
  {"call": "engine.script", "params": {"commands": [
    {"command": "geometry.solid", "params": {"shape": "box", "size": [60, 60, 60]}},
    {"command": "model.open", "params": {"thickness": 15}},
    {"command": "mesh.generate", "params": {"size": 15}},
    {"command": "source.dipole", "params": {"at": [30.1, 30.2, 29.9], "direction": [0, 0, 1], "length": 1, "current": 1}},
    {"command": "solve.radiation", "params": {"frequency": 10, "order": 1}}
  ]}},
  {"until": {"busy": false}, "timeout": 120},
  {"call": "ui.set", "params": {"view": "far_field"}},
  {"frames": 2},
  {"expect": {"view": "far_field", "inspect": {"pattern.cut": "phi", "pattern.angle": 0.0, "pattern.component": "total"}, "handles": ["chart:pattern", "pattern:cut:theta", "pattern:component:phi", "pattern:phi", "chart:style"]}},
  {"shot": "far-field-phi-cut"},
  {"click": "pattern:cut:theta"},
  {"frames": 2},
  {"expect": {"inspect": {"pattern.cut": "theta", "pattern.angle": 90.0, "chart": "*"}}},
  {"click": "pattern:component:theta"},
  {"frames": 2},
  {"expect": {"inspect": {"pattern.component": "theta"}, "handles": ["chart:pattern"]}},
  {"shot": "far-field-theta-cut"},
  {"call": "engine.execute", "params": {"command": "view.pattern", "params": {"path": "$TMP/cut.png", "cut": "theta", "theta": 90, "component": "phi", "points": 37}}},
  {"click": "pattern:cut:phi"},
  {"frames": 2},
  {"expect": {"inspect": {"pattern.cut": "phi", "pattern.angle": 0.0, "pattern.component": "theta"}}}
]
