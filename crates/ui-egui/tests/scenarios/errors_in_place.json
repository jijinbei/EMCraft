[
  {"note": "Errors show where the action happened: an engine refusal under the dialog's field it names (the dialog stays open), a long command's failure brings its dialog back with the error under the field, and Run's refusal lists its reasons under the Run button; the message log keeps them all"},
  {"call": "engine.execute", "params": {"command": "file.sample", "params": {"name": "highpass"}}},
  {"call": "engine.execute", "params": {"command": "project.frequency", "params": {"start": 5, "stop": 9}}},
  {"call": "ui.start", "params": {"command": "geometry.waveguide"}},
  {"click": "dialog:field:width"},
  {"key": "A", "cmd": true},
  {"text": "-5"},
  {"click": "dialog:ok"},
  {"expect": {"dialog": "geometry.waveguide", "status_error": true, "inspect": {"dialog.errors.width": "*", "dialog.error": null, "model.waveguide.width": [22.86, 1e-12]}}},
  {"shot": "errors-dialog-field"},
  {"click": "dialog:cancel"},
  {"note": "A sweep's dialog: the order is refused on the worker; the dialog opens again with it under the field"},
  {"call": "ui.start", "params": {"command": "solve.frequency"}},
  {"click": "dialog:field:order"},
  {"key": "A", "cmd": true},
  {"text": "3"},
  {"click": "dialog:ok"},
  {"until": {"busy": false, "dialog": "solve.frequency"}, "timeout": 60},
  {"expect": {"status_error": true, "inspect": {"dialog.errors.order": "*", "dialog.error": null, "workflow.failure.command": "solve.frequency"}}},
  {"shot": "errors-long-dialog-field"},
  {"call": "ui.set", "params": {"dark": true}},
  {"frames": 2},
  {"shot": "errors-long-dialog-field-dark"},
  {"call": "ui.set", "params": {"dark": false}},
  {"click": "dialog:cancel"},
  {"note": "Run refused: no ports. The reasons sit under the Run button, each with the way to its step"},
  {"call": "engine.script", "params": {"commands": [
    {"command": "file.new", "params": {}},
    {"command": "project.frequency", "params": {"start": 8, "stop": 12}},
    {"command": "geometry.waveguide", "params": {"width": 22.86, "height": 10.16, "sections": [{"length": 30, "material": "vacuum"}]}},
    {"command": "mesh.generate", "params": {"size": 4}}
  ]}},
  {"call": "ui.set", "params": {"step": "setup"}},
  {"click": "setup:solver:frequency"},
  {"click": "step:run"},
  {"expect": {"hidden": ["run:refused:0"]}},
  {"click": "run:start"},
  {"expect": {"busy": false, "status": "Run refused", "handles": ["run:refused:0"], "inspect": {"workflow.refused": "*"}}},
  {"shot": "errors-run-refused"},
  {"click": "run:refused:0"},
  {"expect": {"inspect": {"workflow.step": "excitation"}}}
]
