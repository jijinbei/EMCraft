[
  {"note": "Every chart view packs its blocks the same way: beside the chart in a wide card, under it in a small one. A fast sweep marks its frequencies solved in full on the curves and in the table"},
  {"call": "engine.execute", "params": {"command": "file.sample", "params": {"name": "highpass"}}},
  {"call": "engine.execute", "params": {"command": "solve.frequency", "params": {"start": 6.6, "stop": 9, "points": 17, "order": 1}}},
  {"click": "tab:RESULTS"},
  {"size": [1500, 960]},
  {"call": "ui.set", "params": {"view": "sparameters"}},
  {"frames": 3},
  {"expect": {"view": "sparameters", "handles": ["chart:sparameters", "chart:block:0", "chart:block:1", "sparameters:full"], "inspect": {"packed.beside": {"min": 1}},
    "query": {"command": "results.sparameters", "path": "points.0.full", "value": true}}},
  {"expect": {"query": {"command": "results.sparameters", "path": "points.16.full", "value": true}}},
  {"shot": "packing-sparameters-wide"},
  {"size": [760, 520]},
  {"frames": 3},
  {"expect": {"inspect": {"packed.beside": 0, "packed.under": 2}, "handles": ["chart:block:0"]}},
  {"shot": "packing-sparameters-small"},
  {"note": "A full sweep: every point solved in full, no marks"},
  {"call": "engine.execute", "params": {"command": "solve.frequency", "params": {"start": 6.6, "stop": 9, "points": 5, "order": 1, "sweep": "full"}}},
  {"size": [1500, 960]},
  {"frames": 3},
  {"expect": {"hidden": ["sparameters:full"], "handles": ["chart:block:0"]}},
  {"shot": "packing-sparameters-full-sweep"},
  {"note": "TDR: its note is short, so under the chart even in a wide card"},
  {"call": "ui.set", "params": {"view": "tdr"}},
  {"frames": 3},
  {"expect": {"view": "tdr", "handles": ["chart:tdr", "chart:block:0"], "inspect": {"packed.beside": 0, "packed.under": 1}}},
  {"shot": "packing-tdr-wide"},
  {"note": "A study's table packed the same way: under the chart in a small window"},
  {"call": "engine.script", "params": {"commands": [
    {"command": "file.new", "params": {}},
    {"command": "project.variable", "params": {"name": "a", "value": 10}},
    {"command": "project.variable", "params": {"name": "b", "value": 5}},
    {"command": "model.material.create", "params": {"name": "ptfe-like", "eps_r": 2.0}},
    {"command": "geometry.waveguide", "params": {"width": 22.86, "height": 10.16, "sections": [
      {"length": 15, "material": "ptfe-like"}, {"length": "=a", "material": "vacuum"}, {"length": "=b", "material": "ptfe-like"},
      {"length": 10, "material": "vacuum"}, {"length": 15, "material": "ptfe-like"}]}},
    {"command": "mesh.generate", "params": {"size": 10}},
    {"command": "model.port.create", "params": {"name": "1", "end": "start", "modes": 1}},
    {"command": "model.port.create", "params": {"name": "2", "end": "end", "modes": 1}}
  ]}},
  {"call": "engine.execute", "params": {"command": "study.sweep", "params": {
    "variables": [{"name": "a", "values": [10, 20]}, {"name": "b", "values": [5, 10, 15]}],
    "solve": {"command": "solve.frequency", "params": {"start": 6, "stop": 9, "points": 4, "order": 1}}}}},
  {"until": {"busy": false, "view": "study"}, "timeout": 120},
  {"frames": 3},
  {"expect": {"view": "study", "handles": ["chart:study", "chart:block:0"], "inspect": {"packed.beside": {"min": 0}}}},
  {"shot": "packing-study-wide"},
  {"size": [760, 520]},
  {"frames": 3},
  {"expect": {"inspect": {"packed.beside": 0, "packed.under": 1}}},
  {"shot": "packing-study-small"}
]
