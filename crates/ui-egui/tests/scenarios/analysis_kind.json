[
  {"note": "Step 0 chooses the kind of analysis on four cards: a meshed guide without ports is inferred a resonator (its card marked auto); a click runs project.analysis and the workflow follows it"},
  {"call": "engine.script", "params": {"commands": [
    {"command": "geometry.waveguide", "params": {"width": 22.86, "height": 10.16, "sections": [{"length": 30, "material": "vacuum"}]}},
    {"command": "mesh.generate", "params": {"size": 4}},
    {"command": "project.frequency", "params": {"start": 8, "stop": 12}}
  ]}},
  {"click": "step:intent"},
  {"expect": {"inspect": {"workflow.analysis.kind": "eigenmodes", "workflow.analysis.chosen": false, "workflow.not_needed": []},
    "handles": ["intent:kind:frequency", "intent:kind:eigenmodes", "intent:kind:radiation", "intent:kind:time_domain"]}},
  {"move": "intent:kind:radiation"},
  {"frames": 2},
  {"shot": "kind-cards-inferred"},
  {"note": "A sweep chosen: Excitation is to do, and Setup starts on the sweep"},
  {"click": "intent:kind:frequency"},
  {"expect": {"inspect": {"workflow.analysis.kind": "frequency", "workflow.analysis.chosen": true, "workflow.steps.excitation": "todo", "workflow.solver": "frequency"}}},
  {"note": "A resonator chosen: Excitation is not needed (dimmed), Setup starts on eigenmodes, SIMULATE has its solve"},
  {"click": "intent:kind:eigenmodes"},
  {"expect": {"inspect": {"workflow.analysis.kind": "eigenmodes", "workflow.steps.excitation": "done", "workflow.not_needed": ["excitation"], "workflow.solver": "eigenmodes"}}},
  {"shot": "kind-eigenmodes"},
  {"click": "step:setup"},
  {"expect": {"inspect": {"workflow.step": "setup", "workflow.solver": "eigenmodes"}, "handles": ["toolbar:solve.eigenmodes"]}},
  {"shot": "kind-eigenmodes-setup"},
  {"note": "Radiation in a closed guide: the open boundary is to do, its fix opens model.open"},
  {"click": "step:intent"},
  {"click": "intent:kind:radiation"},
  {"expect": {"inspect": {"workflow.steps.boundaries": "todo", "workflow.messages.boundaries.0.command": "model.open"}}},
  {"click": "step:boundaries"},
  {"click": "step:fix:0"},
  {"expect": {"dialog": "model.open"}},
  {"click": "dialog:cancel"},
  {"note": "Eigenmodes chosen with ports present: a warning whose fix goes back to step 0"},
  {"call": "engine.execute", "params": {"command": "model.port.create", "params": {"name": "1", "end": "start"}}},
  {"click": "step:intent"},
  {"click": "intent:kind:eigenmodes"},
  {"expect": {"inspect": {"workflow.steps.excitation": "warning", "workflow.messages.excitation.0.command": "project.analysis"}}},
  {"click": "step:excitation"},
  {"shot": "kind-eigenmodes-ports"},
  {"click": "step:fix:0"},
  {"expect": {"dialog": null, "inspect": {"workflow.step": "intent"}}},
  {"note": "Undo goes back to radiation"},
  {"key": "Z", "cmd": true},
  {"expect": {"inspect": {"workflow.analysis.kind": "radiation"}}},
  {"note": "In Japanese"},
  {"call": "ui.set", "params": {"language": "ja"}},
  {"click": "intent:kind:time_domain"},
  {"expect": {"inspect": {"workflow.analysis.kind": "time_domain", "workflow.not_needed": ["mesh"]}}},
  {"frames": 2},
  {"shot": "ja-kind-cards"}
]
