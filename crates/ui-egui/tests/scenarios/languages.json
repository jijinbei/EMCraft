[
  {"note": "Languages: English by default (the harness draws Japanese in the embedded font subset, never an installed one, so shots match on every machine); Japanese picked on the settings page changes the window at once (its messages too); handles stay the English ones; ui.set switches back and refuses an unknown language"},
  {"expect": {"inspect": {"language": "en", "languages": ["en", "ja"], "font.japanese": "embedded subset"}}},
  {"click": "bar:settings"},
  {"click": "settings:section:language"},
  {"frames": 2},
  {"expect": {"inspect": {"settings": "language"}, "handles": ["settings:language:en", "settings:language:ja"]}},
  {"click": "settings:language:ja"},
  {"frames": 2},
  {"expect": {"inspect": {"language": "ja", "settings": "language"}, "handles": ["settings:close", "settings:section:appearance", "settings:language:en"]}},
  {"shot": "language-ja-settings"},
  {"click": "settings:section:appearance"},
  {"frames": 2},
  {"shot": "language-ja-settings-appearance"},
  {"note": "The start page"},
  {"click": "bar:start"},
  {"frames": 3},
  {"expect": {"inspect": {"home": true}, "handles": ["home:new", "home:open", "sample:highpass"]}},
  {"shot": "language-ja-start"},
  {"note": "A sample in the workspace: its message in Japanese, the handles in English"},
  {"click": "sample:highpass"},
  {"frames": 3},
  {"expect": {"inspect": {"template.name": "highpass"}, "handles": ["template:field:l_gap", "template:open"]}},
  {"shot": "language-ja-template"},
  {"click": "template:open"},
  {"until": {"busy": false}},
  {"frames": 3},
  {"expect": {"status": "サンプル highpass を開きました", "inspect": {"home": false, "project.name": "highpass"}, "handles": ["tab:MODEL", "tab:PORTS & SOURCES", "step:mesh", "fold:Geometry", "toolbar:geometry.waveguide", "view:model"]}},
  {"click": "toolbar:geometry.waveguide"},
  {"frames": 3},
  {"expect": {"dialog": "geometry.waveguide", "handles": ["dialog:ok", "dialog:field:width"]}},
  {"shot": "language-ja-workspace-dialog"},
  {"click": "dialog:cancel"},
  {"call": "ui.set", "params": {"step": "setup"}},
  {"frames": 3},
  {"expect": {"handles": ["setup:solver:frequency", "setup:points"]}},
  {"shot": "language-ja-setup"},
  {"call": "ui.set", "params": {"step": "none", "tab": "SIMULATE"}},
  {"click": "search:field"},
  {"text": "メッシュ"},
  {"frames": 2},
  {"expect": {"handles": ["search:row:mesh.generate"]}},
  {"shot": "language-ja-search"},
  {"key": "Escape"},
  {"note": "Back to English over the control channel; unknown or ill-typed languages are refused"},
  {"call": "ui.set", "params": {"language": "en"}},
  {"frames": 2},
  {"expect": {"inspect": {"language": "en"}, "handles": ["tab:MODEL"]}},
  {"call": "ui.set", "params": {"language": "klingon"}, "fail": true},
  {"call": "ui.set", "params": {"language": 3}, "fail": true},
  {"expect": {"inspect": {"language": "en"}}}
]
