[
  {"note": "A template opened from the start page lands on the project's Home (step 0, the viewport's first tab): the kind of analysis on four cards with a picture of what each gives, the band with the ports' standard guide band as a preset, the units, the project at a glance and its next step; each choice runs the command the rest of the window runs"},
  {"click": "bar:start"},
  {"click": "sample:straight"},
  {"click": "template:open"},
  {"until": {"busy": false, "inspect": {"home": false, "project.name": "straight"}}, "timeout": 60},
  {"frames": 2},
  {"expect": {"view": "home", "inspect": {"workflow.step": "intent"},
    "handles": ["view:home", "view:model", "step:intent", "project:home", "intent:kind:frequency", "intent:kind:eigenmodes", "intent:kind:radiation", "intent:kind:time_domain",
      "intent:start", "intent:stop", "intent:apply", "home:band:WR-90", "home:units:length:mm", "home:units:frequency:MHz", "home:step:geometry", "home:step:mesh", "home:next"]}},
  {"shot": "home-straight"},
  {"note": "A kind chosen on its card"},
  {"click": "intent:kind:eigenmodes"},
  {"expect": {"inspect": {"workflow.analysis.kind": "eigenmodes", "workflow.analysis.chosen": true, "workflow.not_needed": ["excitation"]}}},
  {"click": "intent:kind:frequency"},
  {"expect": {"inspect": {"workflow.analysis.kind": "frequency", "workflow.not_needed": []}}},
  {"note": "The guide's standard band as a preset, then the band typed"},
  {"click": "home:band:WR-90"},
  {"expect": {"status": "Band 8.2 to 12.4", "inspect": {"workflow.steps.intent": "done"}}},
  {"click": "intent:start"},
  {"key": "A", "cmd": true},
  {"text": "9"},
  {"key": "Enter"},
  {"expect": {"status": "Band 9 to 12.4"}},
  {"note": "The project's units"},
  {"click": "home:units:frequency:MHz"},
  {"expect": {"inspect": {"model.units.frequency": "MHz"}}},
  {"frames": 2},
  {"shot": "home-mhz"},
  {"click": "home:units:frequency:GHz"},
  {"expect": {"inspect": {"model.units.frequency": "GHz"}}},
  {"note": "The next step's button and a summary line open their steps; Home's tab comes back to step 0"},
  {"click": "home:next"},
  {"expect": {"view": "model", "inspect": {"workflow.step": "run"}}},
  {"click": "view:home"},
  {"expect": {"view": "home", "inspect": {"workflow.step": "intent"}}},
  {"click": "home:step:mesh"},
  {"expect": {"view": "model", "inspect": {"workflow.step": "mesh"}}},
  {"click": "step:intent"},
  {"expect": {"view": "home", "inspect": {"workflow.step": "intent"}}},
  {"call": "ui.set", "params": {"dark": true}},
  {"frames": 2},
  {"shot": "home-dark"},
  {"call": "ui.set", "params": {"language": "ja"}},
  {"frames": 2},
  {"shot": "home-ja"},
  {"call": "ui.set", "params": {"language": "en", "dark": false}},
  {"note": "A new project lands on Home too, with no guide to offer a band from"},
  {"click": "menu:file"},
  {"click": "file:new"},
  {"click": "confirm:discard"},
  {"frames": 2},
  {"expect": {"view": "home", "inspect": {"workflow.step": "intent", "project.title": "Untitled"}, "hidden": ["home:band:WR-90"]}},
  {"shot": "home-new"}
]
