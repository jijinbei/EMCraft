[
  {"note": "The start page (the app bar's Start tab) offers the samples; the high-pass filter opens and the browser and the model view show it"},
  {"click": "tab:start"},
  {"expect": {"inspect": {"home": true}, "handles": ["home:new", "home:open", "sample:highpass", "sample:cavity"]}},
  {"click": "tab:project"},
  {"expect": {"inspect": {"home": false}}},
  {"call": "engine.execute", "params": {"command": "file.sample", "params": {"name": "highpass"}}},
  {"expect": {"view": "model", "busy": false, "status": "Opened sample highpass", "status_error": false}},
  {"expect": {"handles": ["fold:Bodies", "fold:Results", "row:waveguide", "row:section:2", "row:port:1"]}},
  {"expect": {"inspect": {"model.mesh.tetrahedra": {"min": 100}, "model.ports.1.name": "2"}}},
  {"expect": {"picture": true}},
  {"shot": "open-sample"},
  {"note": "Folding a browser section hides its rows"},
  {"click": "fold:Bodies"},
  {"expect": {"hidden": ["row:section:2"]}},
  {"click": "fold:Bodies"},
  {"expect": {"handles": ["row:section:2"]}},
  {"note": "Double-clicking the guide opens its dialog on the model's values"},
  {"click": "row:waveguide", "double": true},
  {"expect": {"dialog": "geometry.waveguide", "inspect": {"dialog.fields.width": "22.86", "dialog.fields.sections.1.1": "vacuum"}}},
  {"shot": "waveguide-dialog"},
  {"click": "dialog:cancel"},
  {"expect": {"dialog": null}}
]
