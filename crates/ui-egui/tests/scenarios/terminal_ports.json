[
  {"note": "Coupled strips through both ports: each port a terminal per strip; the chart and the table show S's first column, the field view excites any terminal"},
  {"call": "engine.script", "params": {"commands": [
    {"command": "model.material.create", "params": {"name": "ptfe", "eps_r": 2.2}},
    {"command": "geometry.waveguide", "params": {"width": 10, "height": 2, "sections": [{"length": 3, "material": "ptfe"}],
      "strips": [{"y": 1, "x0": 3, "width": 1.5}, {"y": 1, "x0": 5, "width": 1.5}]}},
    {"command": "model.symmetry", "params": {"axis": "y", "kind": "magnetic"}},
    {"command": "mesh.generate", "params": {"size": 1, "strip_edge": 0.25}},
    {"command": "model.port.create", "params": {"name": "1", "end": "start", "modes": 2}},
    {"command": "model.port.create", "params": {"name": "2", "end": "end", "modes": 2}},
    {"command": "solve.frequency", "params": {"frequencies": [2, 3], "order": 1}}
  ]}},
  {"until": {"busy": false}},
  {"expect": {"view": "sparameters"}},
  {"frames": 2},
  {"shot": "terminal-sparameters"},
  {"click": "view:field"},
  {"frames": 2},
  {"expect": {"view": "field", "inspect": {"field.shown": true, "field.excitation": "1:1"}}},
  {"widget": "1:2"},
  {"frames": 3},
  {"expect": {"inspect": {"field.shown": true, "field.excitation": "1:2"}}},
  {"shot": "terminal-field-1-2"}
]
