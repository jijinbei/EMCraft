[
  {"note": "A chart's axes and looks, edited from the gear on it: kept with the project and followed by its PNG"},
  {"call": "engine.execute", "params": {"command": "file.sample", "params": {"name": "highpass"}}},
  {"call": "engine.execute", "params": {"command": "solve.frequency", "params": {"start": 6, "stop": 8, "points": 5, "order": 1}}},
  {"until": {"busy": false, "inspect": {"model.results.frequencies": 5}}, "timeout": 120},
  {"call": "engine.execute", "params": {"command": "file.save", "params": {"path": "$TMP/styled.emcraft"}}},
  {"expect": {"view": "sparameters", "handles": ["chart:style", "chart:sparameters"], "inspect": {"chart_style.open": false, "project.dirty": false}}},
  {"click": "chart:style"},
  {"frames": 2},
  {"expect": {"inspect": {"chart_style.open": true, "chart_style.curves.0": "*"}, "handles": ["chart:style:x:min", "chart:style:y:log", "chart:style:grid", "chart:legend:top-right", "chart:curve:s21.fem", "chart:colour:s21.fem:3", "chart:width:s21.fem:5"], "inside": ["chart:style:x:min", "chart:style:reset", "chart:style:close"]}},
  {"shot": "chart-style-card"},
  {"note": "The x axis fixed from 6.5 to 7.5 GHz: typed, Enter commits"},
  {"click": "chart:style:x:min"},
  {"text": "6.5"},
  {"key": "Enter"},
  {"frames": 2},
  {"click": "chart:style:x:max"},
  {"text": "7.5"},
  {"key": "Enter"},
  {"frames": 2},
  {"expect": {"inspect": {"chart_style.style.x.min": 6.5, "chart_style.style.x.max": 7.5, "project.dirty": true}}},
  {"note": "No grid, the legend top right, the exact S11 hidden, S21's points in a colour of their own and larger"},
  {"click": "chart:style:grid"},
  {"frames": 2},
  {"click": "chart:legend:top-right"},
  {"frames": 2},
  {"click": "chart:curve:s11.ref"},
  {"frames": 2},
  {"click": "chart:colour:s21.fem:3"},
  {"frames": 2},
  {"click": "chart:width:s21.fem:5"},
  {"frames": 2},
  {"expect": {"inspect": {"chart_style.style.grid": false, "chart_style.style.legend": "top-right", "chart_style.style.hidden.0": "s11.ref", "chart_style.style.curves": "*"}}},
  {"expect": {"query": {"command": "view.chart.style", "params": {"chart": "sparameters"}, "path": "style.hidden", "value": ["s11.ref"]}}},
  {"click": "chart:style:close"},
  {"frames": 2},
  {"expect": {"inspect": {"chart_style.open": false}}},
  {"shot": "chart-styled"},
  {"note": "The PNG export follows the style; Save keeps it"},
  {"call": "engine.execute", "params": {"command": "view.sparameters", "params": {"path": "$TMP/styled.png"}}},
  {"call": "engine.execute", "params": {"command": "file.save", "params": {}}},
  {"expect": {"inspect": {"project.dirty": false}}},
  {"note": "A log axis, then everything automatic again"},
  {"click": "chart:style"},
  {"frames": 2},
  {"click": "chart:style:x:log"},
  {"frames": 2},
  {"expect": {"inspect": {"chart_style.style.x.log": true}}},
  {"shot": "chart-style-log"},
  {"click": "chart:style:reset"},
  {"frames": 2},
  {"expect": {"inspect": {"chart_style.style": {}, "chart_style.open": true}}},
  {"note": "The other charts have the gear too"},
  {"call": "ui.set", "params": {"view": "tdr"}},
  {"frames": 2},
  {"expect": {"handles": ["chart:style", "chart:tdr"], "inspect": {"chart_style.chart": "tdr", "chart_style.open": false}}},
  {"note": "A small window keeps the card inside it"},
  {"call": "ui.set", "params": {"view": "sparameters"}},
  {"size": [900, 640]},
  {"click": "chart:style"},
  {"frames": 2},
  {"expect": {"inside": ["chart:style:x:min", "chart:style:close"]}},
  {"shot": "chart-style-small"}
