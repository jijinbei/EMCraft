  {"expect": {"inspect": {"view3d.tools.grip": null}, "query": {"command": "project.values", "params": {"command": "geometry.body.edit", "body": "body 1"}, "path": "size.0", "value": {"min": 11, "max": 40}}}},
  {"shot": "body-grips-dragged"},
  {"drag": ["view3d:grip:size.x-", {"handle": "view3d:grip:size.x-", "offset": [-40, 0]}]},
