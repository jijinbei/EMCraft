[
  {"note": "A selected box shows a grip on each face (ADR 0005): dragging the +x one out grows the box along x, snapped to the grid, in one geometry.body.edit; the −x one moves its origin too"},
  {"call": "engine.script", "params": {"commands": [
    {"command": "geometry.body", "params": {"shape": "box", "size": [10, 10, 10], "material": "metal"}}
  ]}},
  {"until": {"busy": false}},
  {"call": "ui.set", "params": {"step": "geometry"}},
  {"call": "ui.set", "params": {"standard_view": "front"}},
  {"frames": 2},
  {"click": "row:body:body 1"},
