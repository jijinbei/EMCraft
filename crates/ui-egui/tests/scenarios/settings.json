[
  {"note": "The settings page: opened from the app bar's gear or the start page, a section at a time, each change at once; Done, Escape or the gear again close it"},
  {"call": "engine.execute", "params": {"command": "file.sample", "params": {"name": "highpass"}}},
  {"frames": 2},
  {"click": "bar:settings"},
  {"frames": 2},
  {"expect": {"inspect": {"settings": "appearance", "theme": "light"}, "handles": ["settings:close", "settings:section:appearance", "settings:section:units", "settings:section:3d", "settings:section:dialogs", "settings:section:files", "settings:theme:light", "settings:theme:sepia", "settings:reload_themes"]}},
  {"shot": "settings-appearance"},
  {"note": "A theme's card picks it; the page redraws in it"},
  {"click": "settings:theme:midnight"},
  {"frames": 2},
  {"expect": {"inspect": {"theme": "midnight", "dark": true, "settings": "appearance"}}},
  {"shot": "settings-appearance-midnight"},
  {"click": "settings:theme:light"},
  {"click": "settings:reload_themes"},
  {"expect": {"inspect": {"theme": "light", "theme_problems": []}}},
  {"note": "Units for new projects"},
  {"click": "settings:section:units"},
  {"frames": 2},
  {"expect": {"inspect": {"settings": "units"}, "handles": ["settings:length:mm", "settings:frequency:GHz"]}},
  {"click": "settings:frequency:MHz"},
  {"shot": "settings-units"},
  {"note": "The 3D view's drawing"},
  {"click": "settings:section:3d"},
  {"click": "settings:3d:fast"},
  {"frames": 2},
  {"shot": "settings-3d"},
  {"note": "Dialogs docked"},
  {"click": "settings:section:dialogs"},
  {"click": "settings:dialogs:docked"},
  {"expect": {"inspect": {"dock_dialogs": true}}},
  {"click": "settings:dialogs:floating"},
  {"note": "Files: the recent list (empty here, so Clear does nothing)"},
  {"click": "settings:section:files"},
  {"frames": 2},
  {"expect": {"inspect": {"settings": "files", "recent": []}, "handles": ["settings:clear_recent"]}},
  {"shot": "settings-files"},
  {"note": "Done goes back to the project as it was, its 3D view now drawn by the GPU"},
  {"click": "settings:close"},
  {"frames": 2},
  {"expect": {"inspect": {"settings": null, "home": false, "project.name": "highpass", "view3d.gpu": true}, "handles": ["tab:MODEL"]}},
  {"note": "From the start page, and closed with Escape back to it"},
  {"click": "bar:start"},
  {"frames": 2},
  {"click": "home:settings"},
  {"frames": 2},
  {"expect": {"inspect": {"settings": "appearance", "home": true}}},
  {"key": "Escape"},
  {"frames": 2},
  {"expect": {"inspect": {"settings": null, "home": true}, "handles": ["home:new"]}},
  {"note": "The gear opens and closes it; the house leaves it for the start page"},
  {"click": "bar:settings"},
  {"click": "bar:settings"},
  {"expect": {"inspect": {"settings": null}}},
  {"click": "bar:settings"},
  {"click": "bar:start"},
  {"expect": {"inspect": {"settings": null, "home": true}}},
  {"note": "Over the control channel: a section by name, none to close; unknown ones refused"},
  {"call": "ui.set", "params": {"settings": "dialogs"}},
  {"expect": {"inspect": {"settings": "dialogs"}}},
  {"call": "ui.set", "params": {"settings": "colours"}, "fail": true},
  {"call": "ui.set", "params": {"settings": 3}, "fail": true},
  {"call": "ui.set", "params": {"settings": "none"}},
  {"expect": {"inspect": {"settings": null}}}
]
