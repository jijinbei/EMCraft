[
  {"note": "Picking in the 3D view: a click selects what is under the pointer, highlights it and its browser row; a click on its row selects it in the view; a double-click opens its dialog"},
  {"call": "engine.execute", "params": {"command": "file.sample", "params": {"name": "highpass"}}},
  {"call": "engine.execute", "params": {"command": "geometry.waveguide", "params": {"width": 22.86, "height": 10.16, "sections": [{"length": 15, "material": "ptfe-like"}, {"length": 20, "material": "vacuum"}, {"length": 15, "material": "ptfe-like"}]}}},
  {"call": "ui.set", "params": {"step": "geometry"}},
  {"click": "view3d:std:iso"},
  {"frames": 2},
  {"click": "view3d"},
