[
  {"note": "Results of a changed model say so where they are read: a band over every result view with Re-run, the pictures dimmed, the browser's result rows marked"},
  {"call": "engine.execute", "params": {"command": "file.sample", "params": {"name": "highpass"}}},
  {"call": "engine.execute", "params": {"command": "project.frequency", "params": {"start": 6.5, "stop": 9}}},
  {"call": "ui.set", "params": {"step": "setup"}},
  {"click": "setup:points"},
  {"key": "A", "cmd": true},
  {"text": "3"},
  {"click": "step:run"},
  {"click": "run:start"},
  {"until": {"busy": false, "inspect": {"model.results.frequencies": 3}}, "timeout": 120},
  {"call": "ui.set", "params": {"step": "none", "view": "sparameters"}},
  {"expect": {"view": "sparameters", "inspect": {"workflow.stale": false}, "hidden": ["stale:rerun"]}},
  {"note": "The band changes after the run: the chart still shows the old band, and says it is out of date"},
  {"call": "engine.execute", "params": {"command": "project.frequency", "params": {"start": 6.5, "stop": 10}}},
  {"frames": 2},
  {"expect": {"view": "sparameters", "inspect": {"workflow.stale": true, "workflow.steps.results": "stale"}, "handles": ["stale:rerun", "chart:sparameters"]}},
  {"shot": "stale-sparameters"},
  {"note": "Every result view shows the band"},
  {"call": "ui.set", "params": {"view": "field"}},
  {"frames": 2},
  {"expect": {"handles": ["stale:rerun", "picture:field"]}},
  {"shot": "stale-field"},
  {"call": "ui.set", "params": {"view": "tdr"}},
  {"frames": 2},
  {"expect": {"handles": ["stale:rerun"]}},
  {"call": "ui.set", "params": {"view": "compare"}},
  {"frames": 2},
  {"expect": {"handles": ["stale:rerun"]}},
  {"note": "The model's own views are not results: no band"},
  {"call": "ui.set", "params": {"view": "outline"}},
  {"frames": 2},
  {"expect": {"hidden": ["stale:rerun"]}},
  {"note": "Re-run runs the Setup step's solve again over the new band; the band goes"},
  {"call": "ui.set", "params": {"view": "sparameters"}},
  {"click": "stale:rerun"},
  {"until": {"busy": false, "inspect": {"workflow.stale": false}}, "timeout": 120},
  {"expect": {"view": "sparameters", "hidden": ["stale:rerun"], "inspect": {"model.results.frequencies": 3, "workflow.steps.results": "done"}}},
  {"shot": "stale-rerun-done"}
]
