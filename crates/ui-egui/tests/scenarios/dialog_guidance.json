[
  {
    "call": "ui.set",
    "params": {
      "language": "ja"
    }
  },
  {
    "call": "engine.execute",
    "params": {
      "command": "file.sample",
      "params": {
        "name": "highpass"
      }
    }
  },
  {
    "click": "step:excitation"
  },
  {
    "click": "toolbar:model.port.create"
  },
  {
    "expect": {
      "handles": [
        "dialog:help",
        "dialog:field:name",
        "dialog:field:end"
      ],
      "inspect": {
        "dialog.help": false
      }
    }
  },
  {
    "shot": "guidance-port-basic"
  },
  {
    "click": "dialog:help"
  },
  {
    "expect": {
      "inspect": {
        "dialog.help": true
      }
    }
  },
  {
    "key": "Escape"
  },
  {
    "expect": {
      "dialog": null
    }
  },
  {
    "click": "step:mesh"
  },
  {
    "click": "toolbar:mesh.generate"
  },
  {
    "expect": {
      "handles": [
        "dialog:field:size",
        "dialog:field:per_wavelength",
        "dialog:options"
      ],
      "hidden": [
        "dialog:field:growth"
      ]
    }
  },
  {
    "shot": "guidance-mesh-basic"
  },
  {
    "click": "dialog:options"
  },
  {
    "expect": {
      "handles": [
        "dialog:field:growth"
      ]
    }
  },
  {
    "click": "dialog:field:growth"
  },
  {
    "key": "A",
    "cmd": true
  },
  {
    "text": "1.7"
  },
  {
    "click": "dialog:options"
  },
  {
    "expect": {
      "hidden": [
        "dialog:field:growth"
      ],
      "inspect": {
        "dialog.fields.growth": "1.7"
      }
    }
  },
  {
    "click": "dialog:options"
  },
  {
    "expect": {
      "handles": [
        "dialog:field:growth"
      ],
      "inspect": {
        "dialog.fields.growth": "1.7"
      }
    }
  },
  {
    "click": "dialog:cancel"
  },
  {
    "call": "engine.execute",
    "params": {
      "command": "project.frequency",
      "params": {
        "start": 5,
        "stop": 9
      }
    }
  },
  {
    "click": "step:setup"
  },
  {
    "click": "setup:points"
  },
  {
    "key": "A",
    "cmd": true
  },
  {
    "text": "3"
  },
  {
    "shot": "guidance-setup"
  },
  {
    "click": "step:run"
  },
  {
    "click": "run:start"
  },
  {
    "until": {
      "busy": false,
      "view": "sparameters"
    },
    "timeout": 120
  },
  {
    "expect": {
      "handles": [
        "results:check",
        "results:convergence"
      ]
    }
  },
  {
    "shot": "guidance-results"
  },
  {
    "click": "results:convergence"
  },
  {
    "expect": {
      "dialog": "mesh.adapt"
    }
  },
  {
    "click": "dialog:cancel"
  }
]
