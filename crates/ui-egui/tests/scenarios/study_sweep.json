[
  {"note": "A variable sets a section's length: changed from its browser row it rebuilds the model; swept from the STUDY panel, its curves are charted"},
  {"call": "engine.script", "params": {"commands": [{"command": "project.variable", "params": {"name": "l", "value": 20}}, {"command": "model.material.create", "params": {"name": "ptfe-like", "eps_r": 2.0}}, {"command": "geometry.waveguide", "params": {"width": 22.86, "height": 10.16, "sections": [{"length": 15, "material": "ptfe-like"}, {"length": "=l", "material": "vacuum"}, {"length": 15, "material": "ptfe-like"}]}}, {"command": "mesh.generate", "params": {"size": 10}}, {"command": "model.port.create", "params": {"name": "1", "end": "start", "modes": 1}}, {"command": "model.port.create", "params": {"name": "2", "end": "end", "modes": 1}}]}},
  {"frames": 2},
  {"expect": {"handles": ["fold:Variables", "row:variable:l"], "inspect": {"variables.l": [20, 1e-09], "model.waveguide.sections.1.length": [20, 1e-09]}}},
  {"note": "Double-clicking the variable opens its dialog; a new value rebuilds the model and its mesh"},
  {"click": "row:variable:l", "double": true},
  {"expect": {"dialog": "project.variable", "inspect": {"dialog.fields.name": "l", "dialog.fields.value": "20"}}},
  {"click": "dialog:field:value"},
  {"key": "A", "cmd": true},
  {"text": "25"},
  {"click": "dialog:ok"},
  {"until": {"busy": false, "inspect": {"variables.l": [25, 1e-09]}}, "timeout": 60},
  {"expect": {"status": "l = 25", "status_error": false, "inspect": {"model.waveguide.sections.1.length": [25, 1e-09], "model.waveguide.sections.0.length": [15, 1e-09]}}},
  {"frames": 2},
  {"expect": {"handles": ["row:variable:l"]}},
  {"note": "SIMULATE › STUDY › Sweep: the dialog opens on the variable and a working solve"},
  {"call": "ui.set", "params": {"tab": "SIMULATE"}},
  {"expect": {"handles": ["toolbar:project.variable", "toolbar:study.sweep", "toolbar:study.optimize"]}},
  {"click": "toolbar:study.sweep"},
  {"expect": {"dialog": "study.sweep", "inspect": {"dialog.fields.variable": "l", "dialog.fields.points": "5"}}},
  {"click": "dialog:field:start"},
  {"key": "A", "cmd": true},
  {"text": "15"},
  {"click": "dialog:field:stop"},
  {"key": "A", "cmd": true},
  {"text": "25"},
  {"click": "dialog:field:points"},
  {"key": "A", "cmd": true},
  {"text": "3"},
  {"call": "ui.dialog", "params": {"set": {"solve": {"command": "solve.frequency", "params": {"start": 6, "stop": 9, "points": 7, "order": 1}}}}},
  {"click": "dialog:ok"},
  {"expect": {"dialog": null}},
  {"until": {"busy": false, "view": "study"}, "timeout": 120},
  {"expect": {"status": "Sweep of l: 3 values", "status_error": false, "inspect": {"study.kind": "sweep", "study.rows": 3, "variables.l": [25, 1e-09]}}},
  {"frames": 3},
  {"expect": {"handles": ["chart:study", "study:parameter:s11", "study:parameter:s21", "row:result:study"], "inspect": {"study.chart": "*"}}},
  {"shot": "study_sweep_s11"},
  {"note": "Another S-parameter redraws the chart"},
  {"click": "study:parameter:s21"},
  {"frames": 2},
  {"expect": {"inspect": {"study.parameter": "s21"}}},
  {"shot": "study_sweep_s21"},
  {"note": "Undo takes the variable back; the study stays"},
  {"call": "engine.execute", "params": {"command": "edit.undo", "params": {}}},
  {"expect": {"inspect": {"variables.l": [20, 1e-09], "study.rows": 3}}}
]
