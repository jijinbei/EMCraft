[
  {"note": "A template from the start page: a card with its parameters and its model, drawn again as they change; a value that cannot be built says why and Open waits; Open builds the project from the values"},
  {"click": "bar:start"},
  {"click": "sample:iris-bandpass"},
  {"frames": 3},
  {"expect": {"inspect": {"template.name": "iris-bandpass", "template.fields.irises": "4", "template.preview": true, "template.error": null}, "handles": ["template:field:irises", "template:field:w_end", "template:preview", "template:open", "template:cancel"]}},
  {"shot": "template-card"},
  {"note": "A field under the pointer shows where its parameter is on the model: a dimension with its value"},
  {"move": "template:field:w_end"},
  {"frames": 2},
  {"expect": {"inspect": {"template.active": "w_end"}, "handles": ["template:mark"]}},
  {"shot": "template-mark-w-end"},
  {"move": "template:field:l_end"},
  {"frames": 2},
  {"expect": {"inspect": {"template.active": "l_end"}, "handles": ["template:mark"]}},
  {"shot": "template-mark-l-end"},
  {"move": "template:open"},
  {"frames": 2},
  {"expect": {"inspect": {"template.active": null}, "hidden": ["template:mark"]}},
  {"click": "template:field:irises", "double": true},
  {"key": "A", "cmd": true},
  {"text": "6"},
  {"frames": 3},
  {"expect": {"inspect": {"template.fields.irises": "6", "template.error": null}}},
  {"shot": "template-six-irises"},
  {"note": "An aperture wider than the guide: refused by the template's command, Open waits"},
  {"click": "template:field:w_end", "double": true},
  {"key": "A", "cmd": true},
  {"text": "30"},
  {"frames": 3},
  {"expect": {"inspect": {"template.error": "*"}}},
  {"shot": "template-refused"},
  {"click": "template:open"},
  {"expect": {"inspect": {"template.name": "iris-bandpass", "home": true}}},
  {"click": "template:reset"},
  {"frames": 3},
  {"expect": {"inspect": {"template.fields.w_end": "12.75", "template.fields.irises": "4", "template.error": null}}},
  {"note": "Cancel closes it; opened again, five irises, and Open"},
  {"click": "template:cancel"},
  {"expect": {"inspect": {"template": null, "home": true}}},
  {"click": "sample:iris-bandpass"},
  {"click": "template:field:irises", "double": true},
  {"key": "A", "cmd": true},
  {"text": "5"},
  {"frames": 2},
  {"click": "template:open"},
  {"until": {"busy": false, "inspect": {"home": false, "template": null, "project.name": "iris-bandpass", "variables.irises": 5.0}}, "timeout": 60},
  {"expect": {"inspect": {"model.waveguide.length": [103.5, 1e-09], "model.mesh.tetrahedra": {"min": 100}}}},
  {"shot": "template-opened"}
]
