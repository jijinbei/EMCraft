[
  {"note": "How long a run will take: in Setup and Run before it starts (from a reference machine until a sweep here measures this one), under a solve's dialog, and the time left while it runs"},
  {"call": "engine.execute", "params": {"command": "file.sample", "params": {"name": "highpass"}}},
  {"call": "engine.execute", "params": {"command": "project.frequency", "params": {"start": 6, "stop": 9}}},
  {"call": "ui.set", "params": {"step": "setup"}},
  {"frames": 3},
  {"expect": {"handles": ["setup:estimate"], "inspect": {"estimate.run.seconds": {"min": 0}, "estimate.run.basis": "reference", "estimate.run.command": "solve.frequency"}}},
  {"shot": "estimate-setup"},
  {"note": "More points, more time"},
  {"click": "setup:points"},
  {"key": "A", "cmd": true},
  {"text": "401"},
  {"frames": 3},
  {"expect": {"inspect": {"workflow.setup.points": "401", "estimate.run.seconds": {"min": 0}}}},
  {"click": "setup:solver:eigenmodes"},
  {"frames": 3},
  {"expect": {"inspect": {"estimate.run.command": "solve.eigenmodes"}}},
  {"click": "setup:solver:frequency"},
  {"call": "ui.set", "params": {"step": "run"}},
  {"frames": 3},
  {"expect": {"handles": ["run:estimate"], "inspect": {"estimate.run.command": "solve.frequency"}}},
  {"shot": "estimate-run"},
  {"note": "A solve's dialog says it too"},
  {"call": "ui.set", "params": {"step": "none"}},
  {"call": "ui.start", "params": {"command": "solve.frequency", "params": {"start": 6, "stop": 9, "points": 51, "order": 1}}},
  {"frames": 3},
  {"expect": {"dialog": "solve.frequency", "handles": ["dialog:estimate"], "inspect": {"estimate.dialog.command": "solve.frequency"}}},
  {"shot": "estimate-dialog"},
  {"click": "dialog:cancel"},
  {"note": "While a run goes, the time left"},
  {"call": "engine.execute", "params": {"command": "solve.frequency", "params": {"start": 6.5, "stop": 9, "points": 400, "order": 2, "sweep": "full"}, "wait": false}},
  {"until": {"inspect": {"progress.done": {"min": 1}, "progress.remaining": {"min": 0}}}, "timeout": 120},
  {"expect": {"busy": true, "inspect": {"progress.estimate": {"min": 0}}}},
  {"shot": "estimate-time-left"},
  {"call": "ui.cancel", "params": {}},
  {"expect": {"busy": false}},
  {"note": "After a sweep here, the estimate is this machine's"},
  {"call": "engine.execute", "params": {"command": "solve.frequency", "params": {"start": 6, "stop": 8, "points": 3, "order": 1}}},
  {"call": "ui.set", "params": {"step": "setup"}},
  {"frames": 3},
  {"expect": {"inspect": {"estimate.run.basis": "measured"}}}
]
