[
  {"note": "A chirped pulse through a metre of circular guide (its cell's Bloch wave): the Pulse view runs results.pulse on the worker, charts the input and output power, and their instantaneous frequency (the input's chirp sweeping, the output's left flat)"},
  {"call": "engine.script", "params": {"commands": [
    {"command": "geometry.solid", "params": {"shape": "cylinder", "radius": 10, "length": 16}},
    {"command": "model.port.create", "params": {"name": "1", "end": "start", "modes": 3}},
    {"command": "model.port.create", "params": {"name": "2", "end": "end", "modes": 3}},
    {"command": "solve.revolution.bloch", "params": {"start": 11, "stop": 14, "points": 31, "m": 1, "size": 0.8}}
  ]}},
  {"until": {"busy": false}},
  {"call": "engine.execute", "params": {"command": "results.pulse", "params": {"frequency": 12.5, "width": 4, "length": 1000, "chirp": "linear", "bandwidth": 1}}},
  {"until": {"busy": false}},
  {"frames": 3},
  {"expect": {"view": "pulse", "handles": ["chart:pulse", "pulse:run", "pulse:chirp:optimized", "pulse:show:frequency", "pulse:length"]}},
  {"shot": "pulse-power"},
  {"click": "pulse:show:frequency"},
  {"frames": 3},
  {"shot": "pulse-frequency"},
  {"click": "pulse:chirp:none"},
  {"click": "pulse:run"},
  {"until": {"busy": false}},
  {"frames": 3},
  {"expect": {"view": "pulse"}},
  {"shot": "pulse-unchirped"}
]
