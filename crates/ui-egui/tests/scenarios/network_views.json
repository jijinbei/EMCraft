[
  {"note": "S as a network: a measurement read from a Touchstone file drawn behind the solved points, each port's reflection on a Smith chart (no frequency to pick there), and the ribbon's network commands"},
  {"call": "engine.execute", "params": {"command": "file.sample", "params": {"name": "highpass"}}},
  {"call": "engine.execute", "params": {"command": "solve.frequency", "params": {"start": 6, "stop": 8, "points": 5, "order": 1}}},
  {"until": {"busy": false, "inspect": {"model.results.frequencies": 5}}, "timeout": 120},
  {"call": "engine.execute", "params": {"command": "results.touchstone", "params": {"path": "$TMP/measured.s2p"}}},
  {"call": "engine.execute", "params": {"command": "results.import", "params": {"path": "$TMP/measured.s2p", "name": "bench"}}},
  {"frames": 2},
  {"expect": {"view": "sparameters", "handles": ["chart:sparameters", "sparameters:display"], "hidden": ["sparameters:mixed"]}},
  {"shot": "measured-over-sweep"},
  {"click": "sparameters:display"},
  {"click": "sparameters:show:smith"},
  {"frames": 2},
  {"expect": {"inspect": {"sparameters": "smith", "chart": "*"}, "handles": ["chart:sparameters"], "hidden": ["refine:start"]}},
  {"shot": "smith-chart"},
  {"note": "A click on the Smith chart picks no frequency: the field view stays where it was"},
  {"click": "chart:sparameters"},
  {"frames": 2},
  {"expect": {"view": "sparameters"}},
  {"note": "The ribbon's RESULTS tab: the network commands beside the exports"},
  {"call": "ui.set", "params": {"step": "none", "tab": "RESULTS"}},
  {"frames": 1},
  {"expect": {"handles": ["toolbar:results.import", "toolbar:results.network", "toolbar:results.mixed_mode"]}},
  {"shot": "network-ribbon"},
  {"note": "A four-port measurement pairs in order: mixed mode on the chart"},
  {"call": "engine.execute", "params": {"command": "file.new", "params": {}}},
  {"call": "engine.execute", "params": {"command": "results.import", "params": {"path": "$TMP/lines.s4p"}}},
  {"call": "ui.set", "params": {"view": "sparameters"}},
  {"click": "sparameters:display"},
  {"click": "sparameters:show:db"},
  {"frames": 2},
  {"expect": {"handles": ["sparameters:mixed"]}},
  {"click": "sparameters:mixed"},
  {"frames": 2},
  {"expect": {"inspect": {"chart": {"includes": "SParameters(Db, [], true)"}}}},
  {"shot": "mixed-mode"}
