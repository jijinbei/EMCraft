[
  {"note": "Ports on faces across x and y: a guide along x takes its ports on its x faces through the face port tool, the dialog opening on the face's rectangle and axis"},
  {"call": "engine.execute", "params": {"command": "geometry.solid", "params": {"shape": "box", "size": [30, 22.86, 10.16]}}},
  {"call": "ui.set", "params": {"view": "model", "tab": "PORTS & SOURCES"}},
  {"click": "toolbar:tool:port"},
  {"frames": 2},
  {"call": "ui.set", "params": {"standard_view": "right"}},
  {"frames": 2},
  {"move": "view3d"},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.tools.pointer.port": "inside"}}},
  {"click": "view3d"},
  {"expect": {"dialog": "model.port.create", "inspect": {"dialog.fields.name": "1", "dialog.fields.end": "end", "dialog.fields.axis": "x", "dialog.fields.face": ["30", "0", "0", "22.86", "10.16"]}}},
  {"click": "dialog:ok"},
  {"frames": 3},
  {"expect": {"inspect": {"model.ports.0.name": "1", "model.ports.0.end": "end", "model.ports.0.axis": "x"}}},
  {"note": "The other end, from the left: the guide lies above that face along x"},
  {"call": "ui.set", "params": {"standard_view": "left"}},
  {"frames": 2},
  {"move": "view3d"},
  {"frames": 2},
  {"click": "view3d"},
  {"expect": {"dialog": "model.port.create", "inspect": {"dialog.fields.end": "start", "dialog.fields.axis": "x", "dialog.fields.face": ["0", "0", "0", "22.86", "10.16"]}}},
  {"click": "dialog:ok"},
  {"frames": 3},
  {"expect": {"inspect": {"model.ports.1.name": "2", "model.ports.1.end": "start", "model.ports.1.axis": "x"}}},
  {"key": "Escape"},
  {"call": "ui.set", "params": {"standard_view": "iso"}},
  {"frames": 2},
  {"shot": "side-ports"},
  {"note": "A bend's ports lie across y and x; its reference plane moves along each port's own axis"},
  {"call": "engine.execute", "params": {"command": "file.sample", "params": {"name": "h-bend"}}},
  {"until": {"busy": false}},
  {"call": "ui.set", "params": {"view": "model", "tab": "PORTS & SOURCES", "standard_view": "top"}},
  {"frames": 2},
  {"expect": {"inspect": {"model.ports.0.axis": "y", "model.ports.1.axis": "x"}}},
  {"call": "ui.set", "params": {"tool": "port", "standard_view": "right"}},
  {"frames": 2},
  {"move": "view3d"},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.tools.pointer.port": "existing"}}},
  {"click": "view3d"},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.selected": "Port(1)"}, "handles": ["view3d:refplane"]}},
  {"key": "Escape"},
  {"call": "engine.execute", "params": {"command": "model.port.edit", "params": {"name": "2", "deembed": 10}}},
  {"call": "ui.set", "params": {"standard_view": "iso"}},
  {"frames": 2},
  {"expect": {"inspect": {"deembed": [0.0, 10.0]}}},
  {"shot": "h-bend"}
]
