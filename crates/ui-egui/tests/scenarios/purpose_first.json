[
  {"note": "The start page asks what the job is for first; the templates shown are those made for it, and the project opened is set to it; the ribbon then holds only that kind's commands"},
  {"click": "bar:start"},
  {"expect": {"inspect": {"home": true, "purpose": null}, "handles": ["home:purpose:frequency", "home:purpose:eigenmodes", "home:purpose:radiation", "home:purpose:time_domain", "sample:highpass", "sample:cavity"], "hidden": ["home:blank"]}},
  {"click": "home:purpose:eigenmodes"},
  {"frames": 2},
  {"expect": {"inspect": {"purpose": "eigenmodes"}, "handles": ["home:blank", "sample:cavity", "sample:loaded-sphere"], "hidden": ["sample:highpass", "sample:dipole"]}},
  {"shot": "purpose-eigenmodes"},
  {"click": "sample:cavity"},
  {"click": "template:open"},
  {"until": {"busy": false, "inspect": {"home": false, "project.name": "cavity", "model.analysis.kind": "eigenmodes", "model.analysis.chosen": true}}, "timeout": 60},
  {"call": "ui.set", "params": {"tab": "SIMULATE"}},
  {"frames": 2},
  {"expect": {"handles": ["toolbar:solve.eigenmodes", "tab:MODEL", "tab:SIMULATE"], "hidden": ["toolbar:solve.frequency", "toolbar:solve.radiation", "toolbar:solve.time_domain", "tab:PORTS & SOURCES"]}},
  {"shot": "purpose-eigenmodes-ribbon"},
  {"note": "Radiation: an empty project for it, its ribbon with the open boundary and sources"},
  {"click": "bar:start"},
  {"click": "home:purpose:radiation"},
  {"frames": 2},
  {"expect": {"handles": ["sample:dipole", "sample:open-waveguide"], "hidden": ["sample:cavity"]}},
  {"click": "home:blank"},
  {"until": {"busy": false, "inspect": {"home": false, "model.analysis.kind": "radiation", "model.analysis.chosen": true}}, "timeout": 60},
  {"call": "ui.set", "params": {"tab": "PORTS & SOURCES"}},
  {"frames": 2},
  {"expect": {"handles": ["toolbar:source.dipole", "toolbar:source.plane_wave"]}},
  {"call": "ui.set", "params": {"tab": "SIMULATE"}},
  {"frames": 2},
  {"expect": {"handles": ["toolbar:solve.radiation"], "hidden": ["toolbar:solve.eigenmodes", "toolbar:solve.frequency"]}},
  {"note": "A second click lets the purpose go: every template again"},
  {"click": "bar:start"},
  {"click": "home:purpose:radiation"},
  {"frames": 2},
  {"expect": {"inspect": {"purpose": null}, "handles": ["sample:highpass", "sample:cavity", "sample:dipole"]}}
]
