[
  {"note": "Box selection as in SolidCraft: a plain left drag left to right selects by window (the parts wholly inside), right to left by crossing (the parts it touches); Shift adds; Escape clears; Delete deletes the selected ports through their commands, undo brings them back"},
  {"call": "engine.execute", "params": {"command": "file.sample", "params": {"name": "highpass"}}},
  {"call": "ui.set", "params": {"view": "model", "step": "excitation", "standard_view": "right", "camera": {"projection": "orthographic"}}},
  {"frames": 30},
  {"note": "Seen from the right the guide runs across the view, port 2 at its left end, port 1 at its right"},
  {"drag": [{"handle": "view3d", "offset": [-260, -62]}, {"handle": "view3d", "offset": [-80, 88]}], "release": false},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.box.crossing": false, "view3d.selection": []}}},
  {"shot": "window-dragging"},
  {"drag": [{"handle": "view3d", "offset": [-80, 88]}, {"handle": "view3d", "offset": [-80, 88]}], "press": false},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.selection": ["Port(1)"], "view3d.box": null}, "handles": ["view3d:selected", "view3d:selected:edit", "view3d:selected:delete"]}},
  {"shot": "window"},
  {"note": "Right to left over the same place: the walls it touches come too"},
  {"drag": [{"handle": "view3d", "offset": [-80, 88]}, {"handle": "view3d", "offset": [-260, -62]}], "release": false},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.box.crossing": true}}},
  {"shot": "crossing-dragging"},
  {"drag": [{"handle": "view3d", "offset": [-260, -62]}, {"handle": "view3d", "offset": [-260, -62]}], "press": false},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.selection": ["Guide", "Port(1)"]}, "hidden": ["view3d:selected:edit"]}},
  {"shot": "crossing"},
  {"note": "Escape clears; a window at the left end, then Shift and a window at the right end, selects both ports"},
  {"key": "Escape"},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.selection": [], "view3d.selected": null}, "hidden": ["view3d:selected"]}},
  {"drag": [{"handle": "view3d", "offset": [-260, -62]}, {"handle": "view3d", "offset": [-80, 88]}]},
  {"drag": [{"handle": "view3d", "offset": [80, -62]}, {"handle": "view3d", "offset": [270, 88]}], "shift": true},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.selection": ["Port(1)", "Port(0)"]}, "handles": ["view3d:selected:delete"], "hidden": ["view3d:selected:edit"]}},
  {"shot": "shift-adds"},
  {"note": "A plain window replaces the selection"},
  {"drag": [{"handle": "view3d", "offset": [80, -62]}, {"handle": "view3d", "offset": [270, 88]}]},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.selection": ["Port(0)"]}}},
  {"note": "Shift and a window at the left end: port 2 joins"},
  {"drag": [{"handle": "view3d", "offset": [-260, -62]}, {"handle": "view3d", "offset": [-80, 88]}], "shift": true},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.selection": ["Port(0)", "Port(1)"], "model.ports.1.name": "2"}}},
  {"note": "Delete removes both through model.port.delete; two undos bring them back"},
  {"key": "Delete"},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.selection": [], "model.ports": []}, "hidden": ["row:Port 1 (start): 4 modes", "row:Port 2 (end): 4 modes"]}},
  {"shot": "deleted"},
  {"key": "Z", "cmd": true},
  {"key": "Z", "cmd": true},
  {"frames": 2},
  {"expect": {"inspect": {"model.ports.0.name": "1", "model.ports.1.name": "2"}, "handles": ["row:Port 1 (start): 4 modes", "row:Port 2 (end): 4 modes"]}}
]
