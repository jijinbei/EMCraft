[
  {"note": "Importing a SolidCraft design: step 1 with no geometry offers it beside the waveguide; the dialog shows what can be imported, a large Choose file…, the file's bodies, size and parameters (each editable), one line on what importing makes of it, its other parameters folded under Options and its description behind ?"},
  {"size": [1500, 1200]},
  {"call": "engine.execute", "params": {"command": "file.new"}},
  {"click": "step:geometry"},
  {"frames": 2},
  {"expect": {"dialog": null, "handles": ["step:waveguide", "step:import"]}},
  {"shot": "import-step-empty"},
  {"click": "step:import"},
  {"frames": 2},
  {"expect": {"dialog": "geometry.import", "inspect": {"dialog.options": false, "dialog.help": false, "dialog.detected": null},
              "handles": ["dialog:pick", "dialog:field:path", "dialog:options", "dialog:help"],
              "hidden": ["dialog:field:region", "dialog:field:margin", "dialog:field:keep", "dialog:detected"]}},
  {"shot": "import-dialog-empty"},
  {"call": "ui.set", "params": {"dark": true}},
  {"frames": 2},
  {"shot": "import-dialog-empty-dark"},
  {"call": "ui.set", "params": {"dark": false}},
  {"note": "Choose file… without the system's file dialog asks for the path; the design's body, size and parameters show at once"},
  {"click": "dialog:pick"},
  {"frames": 2},
  {"click": "file:path"},
  {"text": "../../tests/oracle/design-post/post.solidcraft"},
  {"click": "file:ok"},
  {"frames": 3},
  {"expect": {"inspect": {"dialog.fields.path": "../../tests/oracle/design-post/post.solidcraft", "dialog.detected.format": "solidcraft",
