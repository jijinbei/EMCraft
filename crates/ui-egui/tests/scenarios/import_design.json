              "handles": ["dialog:detected", "dialog:param:d", "dialog:param:a"]}},
  {"shot": "import-dialog-design"},
  {"note": "A parameter changed in its row: the design is evaluated at it on import"},
  {"click": "dialog:param:d", "double": true},
  {"key": "A", "cmd": true},
  {"text": "4"},
  {"frames": 2},
  {"expect": {"inspect": {"dialog.fields.parameters": "{\"d\":4.0}"}}},
  {"note": "The help and the options, unfolded"},
  {"click": "dialog:help"},
  {"frames": 2},
  {"click": "dialog:options"},
  {"frames": 2},
  {"shot": "import-dialog-options"},
  {"expect": {"inspect": {"dialog.options": true, "dialog.help": true}, "handles": ["dialog:field:region", "dialog:field:margin", "dialog:field:fit_surfaces"],
              "hidden": ["dialog:field:parameters"]}},
  {"click": "dialog:options"},
  {"frames": 2},
  {"click": "dialog:help"},
  {"frames": 2},
  {"expect": {"inspect": {"dialog.options": false, "dialog.help": false}, "hidden": ["dialog:field:region"]}},
  {"click": "dialog:ok"},
  {"until": {"busy": false}, "timeout": 60},
  {"frames": 3},
  {"expect": {"dialog": null, "inspect": {"model.solid.shape": "*"}}},
  {"call": "ui.set", "params": {"view": "model", "standard_view": "iso"}},
  {"frames": 3},
  {"shot": "import-design-imported"},
  {"note": "A 3MF file dropped on the window opens the dialog on it: two bodies, metal in a box of air"},
  {"call": "ui.drop", "params": {"path": "tests/fixtures/post-and-puck.3mf"}},
  {"frames": 3},
  {"expect": {"dialog": "geometry.import", "inspect": {"dialog.fields.path": "tests/fixtures/post-and-puck.3mf", "dialog.detected.format": "3mf",
              "dialog.detected.bodies.0.name": "Post", "dialog.detected.bodies.1.name": "Puck"}, "handles": ["dialog:detected"]}},
  {"shot": "import-dialog-3mf"},
  {"call": "ui.drop", "params": {"path": ""}, "fail": true},
  {"note": "A file that is not there says so in place; nothing is imported"},
  {"call": "ui.dialog", "params": {"set": {"path": "/no/such/part.3mf"}}},
  {"frames": 2},
  {"expect": {"inspect": {"dialog.detected.error": "*"}}},
  {"click": "dialog:cancel"},
  {"frames": 2},
  {"expect": {"dialog": null}},
