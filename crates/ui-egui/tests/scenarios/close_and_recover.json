[
  {"note": "Unsaved work is copied aside while it waits: a copy every interval (a short one here) in the autosave folder, the project's own file untouched"},
  {"call": "app.autosave", "params": {"dir": "$TMP/autosave", "every": 0.5}},
  {"call": "engine.execute", "params": {"command": "file.sample", "params": {"name": "highpass"}}},
  {"call": "engine.execute", "params": {"command": "file.save", "params": {"path": "$TMP/filter.emcraft"}}},
  {"expect": {"inspect": {"project.dirty": false, "project.name": "filter", "autosave.file": null}}},
  {"call": "engine.execute", "params": {"command": "project.frequency", "params": {"start": 6.5, "stop": 9.5}}},
  {"until": {"inspect": {"autosave.file": "$TMP/autosave/filter.emcraft", "project.dirty": true, "project.path": "$TMP/filter.emcraft"}}, "timeout": 20},
  {"note": "Another project replaces it without asking (a script): the copy stays; the new one gets its own"},
  {"call": "engine.execute", "params": {"command": "file.new"}},
  {"call": "engine.execute", "params": {"command": "model.material.create", "params": {"name": "ptfe", "eps_r": 2.1}}},
  {"until": {"inspect": {"autosave.file": "$TMP/autosave/Untitled.emcraft"}}, "timeout": 20},
  {"note": "As on the next start: the copies newer than their projects are offered on the start page"},
  {"call": "app.autosave", "params": {"dir": "$TMP/autosave"}},
  {"frames": 2},
  {"expect": {"inspect": {"home": true, "autosave.found.0.name": "Untitled", "autosave.found.1.name": "filter", "autosave.found.1.original": "$TMP/filter.emcraft"},
              "handles": ["home:recover:0", "home:recover:1", "home:recover:dismiss:0"]}},
  {"shot": "recover-cards"},
  {"call": "ui.set", "params": {"dark": true}},
  {"frames": 2},
  {"shot": "recover-cards-dark"},
  {"call": "ui.set", "params": {"dark": false}},
  {"note": "Dismissing a copy deletes it"},
  {"click": "home:recover:dismiss:0"},
  {"expect": {"inspect": {"autosave.found.0.name": "filter", "autosave.found.1": null}, "hidden": ["home:recover:1"]}},
  {"note": "Recover: the open project's changes are asked about first; the copy opens as the project, its own file kept, unsaved"},
  {"click": "home:recover:0"},
  {"expect": {"inspect": {"files.confirm": true}}},
  {"click": "confirm:discard"},
  {"until": {"busy": false, "inspect": {"project.name": "filter", "project.path": "$TMP/filter.emcraft", "project.dirty": true}}, "timeout": 60},
  {"expect": {"query": {"command": "project.values", "params": {"command": "project.frequency"}, "path": "stop", "value": [9.5, 1e-9]}}},
  {"expect": {"inspect": {"home": false, "recent.0": "$TMP/filter.emcraft", "autosave.found": [], "autosave.file": "$TMP/autosave/filter.emcraft"}}},
  {"note": "Closing with unsaved changes asks; Cancel keeps the window"},
  {"call": "app.quit"},
  {"expect": {"inspect": {"files.confirm": true, "files.then": "Quit", "quitting": false}, "handles": ["confirm:save", "confirm:discard", "confirm:cancel"]}},
  {"frames": 12},
  {"shot": "close-confirm"},
  {"click": "confirm:cancel"},
  {"expect": {"inspect": {"files.confirm": false, "quitting": false, "project.dirty": true}}},
  {"note": "Closing while a job runs asks to stop it first; Keep running keeps both"},
  {"call": "engine.execute", "params": {"command": "solve.frequency", "params": {"start": 6.5, "stop": 9.5, "points": 101, "order": 2}, "wait": false}},
  {"expect": {"busy": true}},
  {"call": "app.quit"},
  {"expect": {"busy": true, "inspect": {"files.then": "Quit", "quitting": false}, "handles": ["confirm:stop_job", "confirm:cancel"], "hidden": ["confirm:save"]}},
  {"frames": 12},
  {"shot": "close-job"},
  {"click": "confirm:cancel"},
  {"expect": {"busy": true, "inspect": {"files.confirm": false, "quitting": false}}},
  {"note": "Stop it: the job is cancelled, then the changes are asked about; Save saves to the project's file and the window closes, the copy deleted"},
  {"call": "app.quit"},
  {"click": "confirm:stop_job"},
  {"expect": {"busy": false, "inspect": {"files.then": "Quit", "quitting": false}, "handles": ["confirm:save"]}},
  {"click": "confirm:save"},
  {"expect": {"inspect": {"quitting": true, "project.dirty": false, "autosave.file": null}}},
  {"call": "app.autosave", "params": {"dir": "$TMP/autosave"}},
  {"expect": {"inspect": {"autosave.found": []}}}
]
