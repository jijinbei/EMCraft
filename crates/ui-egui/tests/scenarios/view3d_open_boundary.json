[
  {"note": "An open problem: a dipole in a box lined with the PML, the layer shaded in Boundaries"},
  {"call": "engine.script", "params": {"commands": [
    {"command": "geometry.solid", "params": {"shape": "box", "size": [60, 60, 60]}},
    {"command": "model.open", "params": {"thickness": 15}},
    {"command": "source.dipole", "params": {"at": [30.1, 30.2, 29.9], "direction": [0, 0, 1], "length": 1, "current": 1}}
  ]}},
  {"call": "ui.set", "params": {"step": "boundaries"}},
  {"expect": {"inspect": {"view3d.overlay": "boundaries", "view3d.triangles": {"min": 12}}}},
  {"shot": "view3d-dipole-boundaries"},
  {"call": "ui.set", "params": {"step": "excitation"}},
  {"shot": "view3d-dipole-excitation"},
  {"note": "Cut across y through the middle: the dipole in its box of air and the layer, sized"},
  {"call": "ui.set", "params": {"view": "model", "section": {"axis": "y"}}},
  {"click": "view3d:section:look"},
  {"frames": 30},
  {"expect": {"inspect": {"view3d.section.axis": "y"}, "handles": ["view3d:section:dim:0"]}},
  {"shot": "dipole-section"}
]
