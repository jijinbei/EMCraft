[
  {"note": "The 3D view's tools in Japanese: a curved face takes no port and says so; a measurement's line and card"},
  {"call": "ui.set", "params": {"language": "ja"}},
  {"call": "engine.execute", "params": {"command": "geometry.solid", "params": {"shape": "cylinder", "radius": 10, "length": 30}}},
  {"call": "ui.set", "params": {"view": "model", "tool": "port", "standard_view": "top"}},
  {"frames": 2},
  {"move": "view3d"},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.tools.pointer.port": "none"}}},
  {"shot": "ja-port-no"},
  {"click": "view3d"},
  {"expect": {"status_error": true, "status": "ポートは x、y、z に垂直な平らな面に置く", "inspect": {"model.ports": []}}},
  {"call": "engine.execute", "params": {"command": "geometry.solid", "params": {"shape": "box", "size": [20, 10, 30]}}},
  {"call": "ui.set", "params": {"tool": "measure", "standard_view": "iso"}},
  {"move": "view3d"},
  {"click": "view3d"},
  {"move": {"handle": "view3d", "offset": [-180, 100]}},
  {"frames": 2},
  {"move": "view3d:corner:0"},
  {"click": "view3d:corner:0"},
  {"frames": 2},
  {"move": "view3d:tool:measure"},
  {"frames": 2},
  {"expect": {"status": "距離 20.6155 mm", "handles": ["view3d:measure"]}},
  {"shot": "ja-measure"}
