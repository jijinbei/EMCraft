[
  {"note": "Walking the step bar through the high-pass filter, from the kind of analysis to Results: the band, the materials and ports in 3D, the port-mode preview, the mesh's statistics and estimate, the setup, the preflight and the run, then stale results after a change"},
  {"call": "engine.execute", "params": {"command": "file.sample", "params": {"name": "highpass"}}},
  {"expect": {"handles": ["step:intent", "step:geometry", "step:materials", "step:excitation", "step:boundaries", "step:mesh", "step:setup", "step:run", "step:results"]}},
  {"expect": {"inspect": {"workflow.steps.intent": "done", "workflow.steps.geometry": "done", "workflow.steps.setup": "done", "workflow.steps.mesh": "done", "workflow.steps.run": "todo", "workflow.steps.results": "waiting", "workflow.step": null}}},
  {"click": "step:intent"},
  {"expect": {"view": "model", "handles": ["intent:kind:frequency", "intent:kind:eigenmodes"]}},
  {"shot": "workflow-0-intent"},
  {"click": "intent:kind:frequency"},
  {"expect": {"inspect": {"workflow.steps.intent": "done", "workflow.steps.setup": "done"}}},
  {"click": "step:geometry"},
  {"expect": {"inspect": {"workflow.step": "geometry", "view3d.overlay": "plain"}, "handles": ["toolbar:geometry.waveguide", "toolbar:model.region"]}},
  {"shot": "workflow-1-geometry"},
  {"click": "step:materials"},
  {"expect": {"inspect": {"workflow.step": "materials", "view3d.overlay": "materials"}}},
  {"shot": "workflow-2-materials"},
  {"click": "step:excitation"},
  {"expect": {"inspect": {"workflow.step": "excitation", "view3d.overlay": "ports", "workflow.steps.excitation": "done"}}},
  {"click": "excitation:preview"},
  {"until": {"busy": false, "inspect": {"port_modes": true}}, "timeout": 60},
  {"expect": {"status": "Port modes at 9", "view": "model"}},
  {"shot": "workflow-3-excitation"},
  {"click": "step:boundaries"},
  {"expect": {"inspect": {"view3d.overlay": "boundaries"}}},
  {"shot": "workflow-4-boundaries"},
  {"click": "step:mesh"},
  {"expect": {"inspect": {"view3d.overlay": "mesh", "view3d.wired": {"min": 500}}}},
  {"shot": "workflow-5-mesh"},
  {"note": "Mesh's command (the ribbon shows the step's tab) docks its dialog in the step panel, on the mesh as it was made (3 mm elements)"},
  {"click": "toolbar:mesh.generate"},
  {"expect": {"dialog": "mesh.generate", "inspect": {"dialog.fields.size": "3", "dialog.fields.per_wavelength": ""}}},
  {"shot": "workflow-5-mesh-dialog"},
  {"click": "dialog:cancel"},
  {"click": "step:setup"},
  {"expect": {"inspect": {"workflow.solver": "frequency"}, "handles": ["setup:points", "setup:order"]}},
  {"click": "setup:points"},
  {"key": "A", "cmd": true},
  {"text": "3"},
  {"note": "A change in the form is not the settings yet: Setup is to do again and Run waits, until the button confirms it"},
  {"frames": 2},
  {"expect": {"inspect": {"workflow.confirmed": false, "workflow.steps.setup": "todo", "workflow.steps.run": "waiting"}}},
  {"shot": "workflow-6-setup"},
  {"click": "setup:confirm"},
  {"expect": {"status": "Settings confirmed", "inspect": {"workflow.confirmed": true, "workflow.steps.setup": "done"}}},
  {"click": "step:run"},
  {"expect": {"handles": ["run:start"], "inspect": {"workflow.steps.run": "todo"}}},
  {"shot": "workflow-7-run"},
  {"click": "run:start"},
  {"until": {"busy": false, "inspect": {"model.results.frequencies": 3}}, "timeout": 120},
  {"expect": {"view": "sparameters", "inspect": {"workflow.step": "results", "workflow.steps.results": "done", "workflow.steps.run": "done"}}},
  {"click": "results:check"},
  {"expect": {"inspect": {"workflow.check.passive": true}}},
  {"shot": "workflow-8-results"},
  {"note": "Export › Field animation writes one period as a looping animated PNG"},
  {"click": "toolbar:view.animation"},
  {"expect": {"dialog": "view.animation", "inspect": {"dialog.fields.path": "field-animation.png", "dialog.fields.frames": "24", "dialog.fields.frequency": "9"}}},
  {"shot": "workflow-8-video-dialog"},
  {"click": "dialog:cancel"},
  {"note": "The field on its plane inside the model"},
  {"click": "view:model"},
  {"expect": {"view": "model", "inspect": {"view3d.overlay": "field", "view3d.gpu_field": true, "view3d.triangles": {"min": 500}}}},
  {"shot": "workflow-8-field-3d"},
  {"note": "The field's phase plays in 3D too; the nav bar pauses it"},
  {"frames": 20},
  {"expect": {"inspect": {"field.animate": true, "field.phase": {"min": 0.05}}, "handles": ["view3d:play"]}},
  {"click": "view3d:play"},
  {"frames": 2},
  {"expect": {"inspect": {"field.animate": false}}},
  {"click": "view3d:std:top"},
  {"shot": "workflow-8-field-3d-top"},
  {"note": "A change to the model leaves the results stale"},
  {"call": "engine.execute", "params": {"command": "project.setup", "params": {"kind": "frequency", "start": 5, "stop": 10}}},
  {"expect": {"inspect": {"workflow.steps.results": "stale"}}},
  {"click": "step:results"},
  {"click": "step:results"},
  {"expect": {"inspect": {"workflow.step": "results"}}},
  {"shot": "workflow-8-results-stale"},
  {"note": "Undo the change from the Edit menu"},
  {"click": "menu:edit"},
  {"click": "edit:undo"},
  {"expect": {"status": "Undone", "inspect": {"model.results.frequencies": 3}}}
]
