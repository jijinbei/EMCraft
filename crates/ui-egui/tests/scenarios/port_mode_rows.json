[
  {"note": "The Excitation panel's port-mode table points at the 3D view: hovering a row lights that port's face (a transient highlight, the selection stays), clicking it opens the Port modes view at that mode"},
  {"call": "engine.execute", "params": {"command": "file.sample", "params": {"name": "highpass"}}},
  {"call": "engine.execute", "params": {"command": "project.frequency", "params": {"start": 5, "stop": 9}}},
  {"click": "step:excitation"},
  {"click": "excitation:preview"},
  {"until": {"busy": false, "inspect": {"port_modes": true}}, "timeout": 60},
  {"expect": {"view": "model", "handles": ["portmode:row:0", "portmode:row:4"], "inspect": {"view3d.hover": null, "view3d.selected": null}}},
  {"move": "portmode:row:0"},
  {"expect": {"inspect": {"view3d.hover": "Port(0)", "view3d.selected": null}}},
  {"shot": "portmode-hover-port1"},
  {"note": "Port 2's first mode is the fifth row (four modes per port)"},
  {"move": "portmode:row:4"},
  {"expect": {"inspect": {"view3d.hover": "Port(1)", "view3d.selected": null}}},
  {"shot": "portmode-hover-port2"},
  {"move": [700, 400]},
  {"expect": {"inspect": {"view3d.hover": null}}},
  {"click": "portmode:row:5"},
  {"expect": {"view": "port_modes", "inspect": {"workflow.mode_focus.port": "2", "workflow.mode_focus.mode": 1, "workflow.step": "excitation"}, "handles": ["port_modes:focus"]}},
  {"shot": "portmode-click-opens-view"},
  {"call": "ui.set", "params": {"dark": true}},
  {"call": "ui.set", "params": {"view": "model"}},
  {"move": "portmode:row:4"},
  {"expect": {"inspect": {"view3d.hover": "Port(1)"}}},
  {"shot": "portmode-hover-dark"}
]
