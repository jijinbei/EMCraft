[
  {"note": "A system's chain by clicks: the kind chosen at the head of the step bar shows its own four steps (Chain, Setup, Run, Results), its own ribbon tab and browser; the empty view offers a button for each kind of stage, the ribbon adds them, a block's click edits it in the Chain step; every step keeps the System view"},
  {"click": "step:intent"},
  {"click": "intent:kind:system"},
  {"frames": 2},
  {"expect": {"view": "system", "inspect": {"workflow.analysis.kind": "system", "workflow.not_needed": ["excitation", "boundaries", "mesh"]}, "handles": ["system:start:amplifier", "system:add:amplifier", "system:add:data", "toolbar:system.receiver", "step:geometry", "step:setup", "step:run", "step:results"], "hidden": ["step:excitation", "step:boundaries", "step:mesh", "toolbar:geometry.waveguide", "fold:Materials"]}},
  {"shot": "system-empty"},
  {"note": "The empty view's button: the stage's dialog in the Chain step, starting from 20 dB and 1 dB"},
  {"click": "system:start:amplifier"},
  {"frames": 2},
  {"expect": {"view": "system", "dialog": "system.stage.add", "inspect": {"workflow.step": "geometry", "dialog.fields.type": "amplifier", "dialog.fields.gain": "20"}}},
  {"click": "dialog:ok"},
  {"until": {"busy": false, "inspect": {"model.system.stages": ["amplifier 1"]}}, "timeout": 20},
  {"note": "The ribbon adds the next ones"},
  {"click": "system:add:attenuator"},
  {"click": "dialog:ok"},
  {"click": "system:add:amplifier"},
  {"click": "dialog:ok"},
  {"until": {"busy": false, "inspect": {"model.system.stages": ["amplifier 1", "attenuator 1", "amplifier 2"]}}, "timeout": 20},
  {"frames": 2},
  {"expect": {"view": "system", "handles": ["system:stage:amplifier 1", "system:stage:attenuator 1", "system:stage:amplifier 2", "system:panel:attenuator 1", "row:stage:attenuator 1", "row:system:source", "row:system:receiver"]}},
  {"shot": "system-chain-step"},
  {"note": "A click on a block opens its settings to change, in the Chain step"},
  {"click": "system:stage:attenuator 1"},
  {"frames": 2},
  {"expect": {"dialog": "system.stage.edit", "inspect": {"workflow.step": "geometry", "dialog.fields.stage": "attenuator 1", "dialog.fields.loss": "3"}}},
  {"click": "dialog:cancel"},
  {"note": "Every step keeps the System view"},
  {"click": "step:setup"},
  {"frames": 2},
  {"expect": {"view": "system", "inspect": {"workflow.step": "setup"}}},
  {"click": "step:results"},
  {"frames": 2},
  {"expect": {"view": "system", "inspect": {"workflow.step": "results"}}},
  {"note": "The receiver's bandwidth, the band, then Run"},
