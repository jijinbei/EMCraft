  {"call": "engine.execute", "params": {"command": "project.setup", "params": {"kind": "system", "start": 1, "stop": 1.2, "points": 11}}},
  {"call": "engine.execute", "params": {"command": "solve.run", "params": {}}},
  {"until": {"busy": false, "view": "system"}, "timeout": 30},
  {"frames": 2},
  {"expect": {"view": "system", "handles": ["chart:system", "system:chart:along", "system:chart:figure", "row:result:system"], "inspect": {"model.system.nf_db": "*", "chart": "*"}}},
  {"shot": "system-budget"},
  {"click": "system:chart:figure"},
  {"frames": 2},
  {"expect": {"inspect": {"chart": "*", "view": "system"}}},
