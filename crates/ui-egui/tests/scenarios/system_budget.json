[
  {"note": "A system's chain by clicks: the kind chosen at the head of the step bar opens the System view; its buttons add stages through their dialogs, a block's click edits it, its menu deletes it; Setup's band and Solve read the budget, drawn along the chain and tabled stage by stage"},
  {"click": "step:intent"},
  {"click": "intent:kind:system"},
  {"expect": {"view": "system", "inspect": {"workflow.analysis.kind": "system", "workflow.not_needed": ["geometry", "excitation", "boundaries", "mesh"]}, "handles": ["system:add:amplifier", "system:add:data", "system:add:receiver"]}},
  {"frames": 2},
  {"shot": "system-empty"},
  {"note": "An LNA: the dialog starts from 20 dB and 1 dB"},
  {"click": "system:add:amplifier"},
  {"expect": {"dialog": "system.stage.add", "inspect": {"dialog.fields.type": "amplifier", "dialog.fields.gain": "20"}}},
  {"click": "dialog:ok"},
  {"until": {"busy": false, "inspect": {"model.system.stages": ["amplifier 1"]}}, "timeout": 20},
  {"click": "system:add:attenuator"},
  {"click": "dialog:ok"},
  {"click": "system:add:amplifier"},
  {"click": "dialog:ok"},
  {"until": {"busy": false, "inspect": {"model.system.stages": ["amplifier 1", "attenuator 1", "amplifier 2"]}}, "timeout": 20},
  {"frames": 2},
  {"expect": {"handles": ["system:stage:amplifier 1", "system:stage:attenuator 1", "system:stage:amplifier 2"]}},
  {"note": "A click on a block opens its settings to change"},
  {"click": "system:stage:attenuator 1"},
  {"expect": {"dialog": "system.stage.edit", "inspect": {"dialog.fields.stage": "attenuator 1", "dialog.fields.loss": "3"}}},
  {"click": "dialog:cancel"},
  {"note": "The receiver's bandwidth, the band, then Solve"},
  {"call": "engine.execute", "params": {"command": "system.receiver", "params": {"bandwidth": 0.002, "snr": 10}}},
  {"call": "engine.execute", "params": {"command": "project.setup", "params": {"kind": "system", "start": 1, "stop": 1.2, "points": 11}}},
  {"frames": 2},
  {"click": "system:add:solve"},
  {"until": {"busy": false, "view": "system"}, "timeout": 30},
  {"frames": 2},
  {"expect": {"view": "system", "handles": ["chart:system", "system:chart:along", "system:chart:figure"], "inspect": {"model.system.nf_db": "*", "chart": "*"}}},
  {"shot": "system-budget"},
  {"click": "system:chart:figure"},
  {"frames": 2},
  {"expect": {"inspect": {"chart": "*", "view": "system"}}},
  {"note": "The ADS-B receiver template opens with its budget read: the antenna's and filter's S as EMCraft solved them"},
  {"call": "engine.execute", "params": {"command": "file.sample", "params": {"name": "adsb-receiver"}}},
  {"frames": 2},
  {"expect": {"view": "system", "handles": ["system:stage:LNA", "system:stage:band-pass filter", "system:stage:receiver", "chart:system"], "inspect": {"model.system.stages": ["LNA", "band-pass filter", "receiver"], "model.system.nf_db": "*"}}},
  {"shot": "system-adsb-receiver"},
  {"note": "In Japanese"},
  {"call": "ui.set", "params": {"language": "ja"}},
  {"frames": 2},
  {"shot": "ja-system-budget"}
]
