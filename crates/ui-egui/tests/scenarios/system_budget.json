[
  {"note": "A system as a node editor: no steps; the band over a canvas whose nodes are edited in place; links dragged from an output port to an input port, taken away by their mark; a right-click adds a stage off the chain; the budget read again at every change"},
  {"click": "step:intent"},
  {"click": "intent:kind:system"},
  {"frames": 2},
  {"expect": {"view": "system", "inspect": {"workflow.analysis.kind": "system"}, "handles": ["system:start:amplifier", "system:add:amplifier", "system:band:start"], "hidden": ["step:geometry", "step:setup", "step:run", "step:mesh", "toolbar:geometry.waveguide", "fold:Materials"]}},
  {"shot": "system-empty"},
  {"note": "The band first, typed in place: the stop follows a fifth above the start"},
  {"click": "system:band:start"},
  {"text": "1"},
  {"key": "Enter"},
  {"frames": 3},
  {"expect": {"query": {"command": "project.values", "params": {"command": "project.setup"}, "path": "stop", "value": 1.2}}},
  {"note": "Stages from the empty view and the ribbon: each at the chain's end, read at once"},
  {"click": "system:start:amplifier"},
  {"until": {"busy": false, "inspect": {"model.system.stages": ["amplifier 1"]}}, "timeout": 10},
  {"click": "system:add:attenuator"},
  {"click": "system:add:amplifier"},
  {"until": {"busy": false, "inspect": {"model.system.stages": ["amplifier 1", "attenuator 1", "amplifier 2"]}}, "timeout": 10},
  {"frames": 3},
  {"expect": {"view": "system", "handles": ["system:node:amplifier 1", "system:out:@source", "system:in:@receiver", "system:field:attenuator 1:loss", "system:unlink:attenuator 1", "chart:system"], "inspect": {"model.system.nf_db": "*"}}},
  {"shot": "system-canvas"},
  {"note": "A field typed in place: the pad's loss to 6 dB, the budget read again"},
  {"click": "system:field:attenuator 1:loss"},
  {"key": "A", "cmd": true},
  {"text": "6"},
  {"key": "Enter"},
  {"frames": 3},
  {"expect": {"query": {"command": "project.values", "params": {"command": "system.stage.edit", "stage": "attenuator 1"}, "path": "loss", "value": 6.0}}},
  {"note": "The link into the second amplifier taken away: it is off the chain"},
  {"click": "system:unlink:amplifier 2"},
  {"frames": 3},
  {"expect": {"inspect": {"model.system.stages": ["amplifier 1", "attenuator 1", "amplifier 2"]}}},
  {"note": "Linked again by dragging from the pad's output to its input"},
  {"drag": ["system:out:attenuator 1", "system:in:amplifier 2"]},
  {"frames": 3},
  {"expect": {"query": {"command": "system.unlink", "params": {"from": "attenuator 1", "to": "amplifier 2"}, "path": "complete", "value": "*"}}},
  {"shot": "system-relinked"},
  {"note": "The ADS-B receiver template opens with its budget read: the antenna's and filter's S as EMCraft solved them"},
  {"call": "engine.execute", "params": {"command": "file.sample", "params": {"name": "adsb-receiver"}}},
  {"frames": 3},
  {"expect": {"view": "system", "handles": ["system:node:LNA", "system:node:band-pass filter", "system:node:RX", "chart:system", "row:measured:filter"], "inspect": {"model.system.stages": ["LNA", "band-pass filter", "RX"], "model.system.nf_db": "*"}}},
  {"shot": "system-adsb-receiver"},
  {"note": "In Japanese"},
  {"call": "ui.set", "params": {"language": "ja"}},
  {"frames": 2},
  {"shot": "ja-system-budget"}
