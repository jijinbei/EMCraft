[
  {"note": "A lumped port by two clicks, each snapped to a corner, an edge's middle or a face's centre; the port is then picked in 3D by its marker"},
  {"call": "engine.script", "params": {"commands": [
    {"command": "geometry.solid", "params": {"shape": "box", "size": [40, 40, 40]}},
    {"command": "geometry.inclusion", "params": {"shape": "box", "size": [10, 8, 6], "at": [15, 16, 17]}},
    {"command": "model.open", "params": {"thickness": 5}}
  ]}},
  {"until": {"busy": false}},
  {"call": "ui.set", "params": {"view": "model", "step": "excitation", "standard_view": "front", "camera": {"projection": "orthographic"}}},
  {"frames": 2},
  {"click": "step:tool:lumped"},
  {"expect": {"inspect": {"view3d.tools.tool": "lumped"}, "handles": ["view3d:tool:lumped"]}},
  {"move": "view3d"},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.tools.pointer.kind": "centre", "view3d.tools.pointer.at": [20.0, 20.0, 23.0]}, "handles": ["view3d:corner:0"]}},
  {"move": "view3d:corner:0"},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.tools.pointer.kind": "vertex", "view3d.tools.pointer.at": [15.0, 16.0, 23.0]}}},
  {"click": "view3d:corner:0"},
  {"expect": {"inspect": {"view3d.tools.picks.0.kind": "vertex"}}},
  {"move": "view3d:corner:3"},
  {"frames": 2},
  {"shot": "lumped-second-point"},
  {"click": "view3d:corner:3"},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.tools.picks": []}, "handles": ["row:Lumped port 1: 50 Ω"], "query": {"command": "project.values", "params": {"command": "model.port.lumped.edit", "name": "1"}, "path": "to", "value": [25.0, 24.0, 23.0]}}},
  {"note": "The tool off, a click on the port's marker selects it"},
  {"key": "Escape"},
  {"expect": {"inspect": {"view3d.tools.tool": null}}},
  {"click": "view3d"},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.selected": "Lumped(0)"}, "handles": ["view3d:selected:edit", "view3d:selected:delete"]}},
  {"shot": "lumped-selected"},
  {"click": "view3d:selected:delete"},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.selected": null}, "hidden": ["row:Lumped port 1: 50 Ω", "view3d:selected"]}}
]
