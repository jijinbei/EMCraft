[
  {"note": "The 3D view is drawn by the GPU only. The headless window has no wgpu device of its own, so the view is drawn offscreen on the process's device (a GPU, or a software adapter such as llvmpipe) and read back"},
  {"call": "engine.execute", "params": {"command": "file.sample", "params": {"name": "inductive-post"}}},
  {"until": {"busy": false}},
  {"call": "ui.set", "params": {"step": "materials"}},
  {"click": "view3d:std:iso"},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.gpu": true, "view3d.renderer": "offscreen", "view3d.gpu_adapter": "*"}}},
  {"shot": "view3d-offscreen"},
  {"note": "Picking reads the tags the GPU drew under the pointer"},
  {"click": "view3d"},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.selected": "*", "view3d.picked_by": "*"}}},
  {"note": "What the GPU adds, each its own switch (edges, outline, picking and the field on by default; shadows off)"},
  {"click": "bar:settings"},
  {"click": "settings:section:3d"},
  {"expect": {"inspect": {"drawing.gpu.edges": true, "drawing.gpu.ao": false, "drawing.gpu.outline": true, "drawing.gpu.pick": true, "drawing.gpu.field": true}, "handles": ["settings:3d:edges", "settings:3d:ao", "settings:3d:outline", "settings:3d:pick", "settings:3d:field"]}},
  {"click": "settings:3d:ao"},
  {"click": "settings:3d:edges"},
  {"expect": {"inspect": {"drawing.gpu.edges": false, "drawing.gpu.ao": true}}},
  {"shot": "settings-3d-gpu"},
  {"note": "Picking off: the CPU's rays find the same part"},
  {"click": "settings:3d:pick"},
  {"key": "Escape"},
  {"click": "view3d"},
  {"frames": 2},
  {"expect": {"inspect": {"drawing.gpu.pick": false, "view3d.renderer": "offscreen", "view3d.picked_by": "cpu", "view3d.selected": "*"}}}
]
