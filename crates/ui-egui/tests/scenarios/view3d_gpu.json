[
  {"note": "Settings ▸ 3D view ▸ Drawing: GPU (the default), Quality or Fast. The headless window has no wgpu device, so GPU falls back to the CPU's picture at rest; Fast draws with egui's painter in depth order"},
  {"call": "engine.execute", "params": {"command": "file.sample", "params": {"name": "inductive-post"}}},
  {"until": {"busy": false}},
  {"call": "ui.set", "params": {"step": "materials"}},
  {"click": "view3d:std:iso"},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.gpu": false, "view3d.renderer": "cpu"}}},
  {"shot": "view3d-cpu"},
  {"click": "bar:settings"},
  {"click": "settings:section:3d"},
  {"expect": {"handles": ["settings:3d:gpu", "settings:3d:quality", "settings:3d:fast"]}},
  {"click": "settings:3d:fast"},
  {"key": "Escape"},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.gpu": true, "view3d.renderer": "painter"}}},
  {"shot": "view3d-gpu"},
  {"note": "Picking works the same"},
  {"click": "view3d"},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.selected": "*"}}},
  {"note": "Back to GPU: without a device, the CPU's picture"},
  {"click": "bar:settings"},
  {"click": "settings:section:3d"},
  {"click": "settings:3d:gpu"},
  {"key": "Escape"},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.gpu": false, "view3d.renderer": "cpu"}}},
  {"note": "Quality draws the CPU's picture at rest too"},
  {"click": "bar:settings"},
  {"click": "settings:section:3d"},
  {"click": "settings:3d:quality"},
  {"key": "Escape"},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.renderer": "cpu", "drawing.mode": "cpu"}}},
  {"note": "What the GPU adds, each its own switch (edges, outline, picking and the field on by default; shadows off); headless, the CPU draws and picks"},
  {"click": "bar:settings"},
  {"click": "settings:section:3d"},
  {"expect": {"inspect": {"drawing.gpu.edges": true, "drawing.gpu.ao": false, "drawing.gpu.outline": true, "drawing.gpu.pick": true, "drawing.gpu.field": true}, "handles": ["settings:3d:edges", "settings:3d:ao", "settings:3d:outline", "settings:3d:pick", "settings:3d:field"]}},
  {"click": "settings:3d:ao"},
  {"click": "settings:3d:edges"},
  {"expect": {"inspect": {"drawing.gpu.edges": false, "drawing.gpu.ao": true}}},
  {"shot": "settings-3d-gpu"},
  {"click": "settings:3d:gpu"},
  {"key": "Escape"},
  {"click": "view3d"},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.renderer": "cpu", "view3d.picked_by": "cpu", "view3d.gpu_adapter": null}}}
]
