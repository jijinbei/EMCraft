[
  {"note": "A project keeps its confirmed settings: opened again, the Setup step's form shows them confirmed, and Run runs them; a changed field is not the settings until confirmed"},
  {"call": "engine.execute", "params": {"command": "file.sample", "params": {"name": "highpass"}}},
  {"call": "engine.execute", "params": {"command": "project.setup", "params": {"kind": "frequency", "start": 6.5, "stop": 9, "points": 2, "order": 1}}},
  {"call": "engine.execute", "params": {"command": "solve.run"}},
  {"until": {"busy": false, "inspect": {"model.results.frequencies": 2}}, "timeout": 120},
  {"call": "engine.execute", "params": {"command": "file.save", "params": {"path": "$TMP/run.emcraft"}}},
  {"call": "engine.execute", "params": {"command": "file.new"}},
  {"frames": 2},
  {"expect": {"inspect": {"workflow.confirmed": false, "workflow.setup.start": ""}}},
  {"call": "engine.execute", "params": {"command": "file.open", "params": {"path": "$TMP/run.emcraft"}}},
  {"call": "ui.set", "params": {"step": "setup"}},
  {"frames": 2},
  {"expect": {"handles": ["setup:confirm"], "inspect": {"workflow.solver": "frequency", "workflow.setup.start": "6.5", "workflow.setup.points": "2", "workflow.setup.order": "1", "workflow.confirmed": true, "workflow.steps.setup": "done", "model.results.frequencies": 2}}},
  {"shot": "setup-restored"},
  {"note": "Run: the confirmed settings"},
  {"click": "step:run"},
  {"click": "run:start"},
  {"until": {"busy": false, "inspect": {"model.results.frequencies": 2, "model.results.order": 1}}, "timeout": 120},
  {"expect": {"inspect": {"project.dirty": false}}},
  {"note": "A field changed: Setup is to do again and Run is refused until the button confirms it"},
  {"call": "ui.set", "params": {"step": "setup"}},
  {"click": "setup:points"},
  {"key": "A", "cmd": true},
  {"text": "3"},
  {"frames": 2},
  {"expect": {"inspect": {"workflow.confirmed": false, "workflow.steps.setup": "todo", "workflow.steps.run": "waiting"}}},
  {"shot": "setup-changed"},
  {"click": "step:run"},
  {"click": "run:start"},
  {"expect": {"busy": false, "status_error": true, "status": "Run refused"}},
  {"call": "ui.set", "params": {"step": "setup"}},
  {"click": "setup:confirm"},
  {"click": "step:run"},
  {"click": "run:start"},
  {"until": {"busy": false, "inspect": {"model.results.frequencies": 3}}, "timeout": 120}
]
