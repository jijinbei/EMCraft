[
  {"note": "A project keeps its last run: opened again, the Setup step shows that run's settings, and Run (or Re-run) runs it again as it was"},
  {"call": "engine.execute", "params": {"command": "file.sample", "params": {"name": "highpass"}}},
  {"call": "engine.execute", "params": {"command": "project.frequency", "params": {"start": 6.5, "stop": 9}}},
  {"call": "engine.execute", "params": {"command": "solve.frequency", "params": {"frequencies": [7, 8.5], "order": 1}}},
  {"call": "engine.execute", "params": {"command": "file.save", "params": {"path": "$TMP/run.emcraft"}}},
  {"call": "engine.execute", "params": {"command": "file.new"}},
  {"expect": {"inspect": {"workflow.rerun": null}}},
  {"call": "engine.execute", "params": {"command": "file.open", "params": {"path": "$TMP/run.emcraft"}}},
  {"call": "ui.set", "params": {"step": "setup"}},
  {"frames": 2},
  {"expect": {"inspect": {"workflow.solver": "frequency", "workflow.setup.points": "2", "workflow.setup.order": "1", "workflow.rerun": "solve.frequency", "model.results": null}}},
  {"shot": "setup-restored"},
  {"note": "Run: the run again, its own frequencies (not points over the band)"},
  {"click": "step:run"},
  {"click": "run:start"},
  {"until": {"busy": false, "inspect": {"model.results.frequencies": 2, "model.results.order": 1}}, "timeout": 120},
  {"expect": {"inspect": {"project.dirty": false}}},
  {"note": "A field changed: Run starts the Setup step's solve instead"},
  {"call": "ui.set", "params": {"step": "setup"}},
  {"click": "setup:points"},
  {"key": "A", "cmd": true},
  {"text": "3"},
  {"frames": 2},
  {"expect": {"inspect": {"workflow.rerun": null}}},
  {"click": "step:run"},
  {"click": "run:start"},
  {"until": {"busy": false, "inspect": {"model.results.frequencies": 3}}, "timeout": 120}
]
