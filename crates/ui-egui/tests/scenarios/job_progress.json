[
  {"note": "A run in progress: its stage and count in the messages, in the open step's panel (with Cancel) and left of the settings in the app bar; Run's chip turns; the panel stays where it was"},
  {"call": "engine.execute", "params": {"command": "file.sample", "params": {"name": "highpass"}}},
  {"call": "ui.set", "params": {"step": "run"}},
  {"call": "engine.execute", "params": {"command": "solve.frequency", "params": {"start": 6.5, "stop": 9, "points": 400, "order": 2, "sweep": "full"}, "wait": false}},
  {"until": {"inspect": {"progress.stage": "frequency", "progress.done": {"min": 1}}}, "timeout": 120},
  {"expect": {"busy": true, "inspect": {"workflow.step": "run", "workflow.running": true, "progress.total": 400}, "handles": ["job:cancel", "status:cancel", "bar:job"]}},
  {"shot": "job-progress-run-step"},
  {"expect": {"inspect": {"progress.device.device": "cpu", "progress.device.gpu": false}, "handles": ["status:device"]}},
  {"note": "Escape does not cancel: Cancel is a click"},
  {"key": "Escape"},
  {"frames": 2},
  {"expect": {"busy": true}},
  {"note": "Another step's panel shows the run too"},
  {"click": "step:mesh"},
  {"expect": {"busy": true, "inspect": {"workflow.step": "mesh"}, "handles": ["job:cancel"]}},
  {"shot": "job-progress-mesh-step"},
  {"click": "job:cancel"},
  {"expect": {"busy": false, "status": "cancelled", "inspect": {"model.results": null, "workflow.running": false}}},
  {"note": "A run started from a docked dialog keeps its place at the right with its progress until it ends"},
  {"call": "ui.set", "params": {"step": "none"}},
  {"click": "tab:SIMULATE"},
  {"click": "toolbar:solve.frequency"},
  {"expect": {"dialog": "solve.frequency", "inspect": {"dialog.docked": true}}},
  {"call": "ui.dialog", "params": {"set": {"start": "6.5", "stop": "9", "points": "400", "order": "2", "sweep": "full"}}},
  {"click": "dialog:ok"},
  {"until": {"inspect": {"progress.done": {"min": 1}}}, "timeout": 120},
  {"expect": {"busy": true, "dialog": null, "handles": ["job:cancel"]}},
  {"shot": "job-progress-docked"},
  {"click": "job:cancel"},
  {"expect": {"busy": false}},
  {"note": "A view chosen while a run goes on stays when it ends"},
  {"call": "engine.execute", "params": {"command": "solve.frequency", "params": {"start": 6.5, "stop": 9, "points": 12, "order": 1, "sweep": "full"}, "wait": false}},
  {"call": "ui.set", "params": {"view": "outline"}},
  {"until": {"busy": false, "inspect": {"model.results.frequencies": 12}}, "timeout": 120},
  {"expect": {"view": "outline"}},
  {"note": "Without a change of view, the run's end shows its results"},
  {"call": "engine.execute", "params": {"command": "solve.frequency", "params": {"start": 6.5, "stop": 9, "points": 3, "order": 1}, "wait": false}},
  {"until": {"busy": false}, "timeout": 120},
  {"expect": {"view": "sparameters"}}
]
