[
  {"note": "The 3D view of the high-pass filter: standard views, orbit by dragging, pan with shift, zoom with the wheel, perspective and orthographic, fit"},
  {"call": "engine.execute", "params": {"command": "file.sample", "params": {"name": "highpass"}}},
  {"expect": {"view": "model", "handles": ["view3d", "view3d:fit", "view3d:std:iso", "view3d:std:front", "view3d:std:top", "view3d:projection"]}},
  {"expect": {"inspect": {"view3d.triangles": {"min": 100}, "view3d.lines": {"min": 12}, "view3d.overlay": "plain", "view3d.pitch": [35.264, 1e-3]}}},
  {"shot": "view3d-highpass-iso"},
  {"click": "view3d:std:front"},
  {"expect": {"inspect": {"view3d.yaw": [0, 1e-9], "view3d.pitch": [0, 1e-9]}}},
  {"shot": "view3d-highpass-front"},
  {"click": "view3d:std:top"},
  {"expect": {"inspect": {"view3d.pitch": [90, 1e-9]}}},
  {"click": "view3d:std:right"},
  {"expect": {"inspect": {"view3d.yaw": [90, 1e-9], "view3d.pitch": [0, 1e-9]}}},
  {"click": "view3d:std:iso"},
  {"note": "Orbit: a left drag across the view turns it"},
  {"drag": [[700, 500], [820, 440]]},
  {"expect": {"inspect": {"view3d.yaw": {"min": 340, "max": 355}, "view3d.pitch": {"min": 5, "max": 10}}}},
  {"shot": "view3d-highpass-orbited"},
  {"note": "Zoom with the wheel, then fit again"},
  {"call": "ui.scroll", "params": {"x": 700, "y": 500, "delta": 3}},
  {"frames": 3},
  {"call": "ui.set", "params": {"camera": {"projection": "orthographic"}}},
  {"click": "view3d:fit"},
  {"expect": {"inspect": {"view3d.projection": "orthographic"}}},
  {"shot": "view3d-highpass-ortho"},
  {"click": "view3d:projection"},
  {"expect": {"inspect": {"view3d.projection": "perspective"}}},
  {"note": "Hostile camera values are refused or sanitised"},
  {"call": "ui.set", "params": {"standard_view": "sideways"}, "fail": true},
  {"call": "ui.set", "params": {"camera": {"yaw": 1e308, "pitch": -1e308, "distance": -4}}},
  {"expect": {"inspect": {"view3d.pitch": [-90, 1e-9], "view3d.distance": {"min": 1e-12}}}},
  {"frames": 2},
  {"expect": {"picture": true}}
]
