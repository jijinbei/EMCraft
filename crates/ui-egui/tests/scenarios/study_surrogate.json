[
  {"note": "Surrogate studies: a sweep that solves four of seven values and predicts the rest (dashed, over ± σ), one at a single frequency (hollow markers), and a Bayesian optimization of a quarter-wave match"},
  {"call": "engine.script", "params": {"commands": [
    {"command": "project.variable", "params": {"name": "l", "value": 20}},
    {"command": "model.material.create", "params": {"name": "ptfe-like", "eps_r": 2.0}},
    {"command": "geometry.waveguide", "params": {"width": 22.86, "height": 10.16, "sections": [
      {"length": 15, "material": "ptfe-like"}, {"length": "=l", "material": "vacuum"}, {"length": 15, "material": "ptfe-like"}]}},
    {"command": "mesh.generate", "params": {"size": 8}},
    {"command": "model.port.create", "params": {"name": "1", "end": "start", "modes": 1}},
    {"command": "model.port.create", "params": {"name": "2", "end": "end", "modes": 1}}
  ]}},
  {"note": "SIMULATE › Sweep: the dialog carries the surrogate's budget"},
  {"click": "tab:SIMULATE"},
  {"click": "toolbar:study.sweep"},
  {"expect": {"dialog": "study.sweep", "handles": ["dialog:field:surrogate"]}},
  {"call": "ui.dialog", "params": {"set": {"start": 14, "stop": 26, "points": 7, "outputs": ["s21", "s11"], "surrogate": {"budget": 4},
    "solve": {"command": "solve.frequency", "params": {"frequencies": [7, 7.5, 8, 8.5, 9], "order": 1}}}}},
  {"click": "dialog:ok"},
  {"expect": {"dialog": null}},
  {"until": {"busy": false, "view": "study"}, "timeout": 120},
  {"expect": {"status": "Sweep of l: 7 values", "status_error": false, "inspect": {"study.kind": "sweep", "study.rows": 7, "study.predicted": 3, "study.surrogate": true}}},
  {"frames": 3},
  {"expect": {"handles": ["chart:study", "study:parameter:s21"], "inspect": {"study.chart": "*"}}},
  {"click": "study:parameter:s21"},
  {"frames": 2},
  {"shot": "study_surrogate_sweep"},
  {"note": "At one frequency: |S21| against l, solved points filled, predicted ones hollow, the band ± σ"},
  {"call": "engine.execute", "params": {"command": "study.sweep", "params": {"variable": "l", "start": 12, "stop": 28, "points": 9, "outputs": ["s21"],
    "surrogate": {"budget": 4}, "solve": {"command": "solve.frequency", "params": {"frequencies": [8], "order": 1}}}}},
  {"until": {"busy": false, "view": "study"}, "timeout": 120},
  {"expect": {"inspect": {"study.rows": 9, "study.predicted": 5}}},
  {"frames": 3},
  {"shot": "study_surrogate_one_frequency"},
  {"note": "SIMULATE › Optimize with method bayesian: every evaluation a solve, the surrogate's guess at the best in the summary"},
  {"call": "engine.script", "params": {"commands": [
    {"command": "file.new", "params": {}},
    {"command": "project.variable", "params": {"name": "l", "value": 8}},
    {"command": "model.material.create", "params": {"name": "match", "eps_r": 1.380001328637192}},
    {"command": "model.material.create", "params": {"name": "load", "eps_r": 2.2}},
    {"command": "geometry.waveguide", "params": {"width": 22.86, "height": 10.16, "sections": [
      {"length": 8, "material": "vacuum"}, {"length": "=l", "material": "match"}, {"length": 8, "material": "load"}]}},
    {"command": "mesh.generate", "params": {"size": 5}},
    {"command": "model.port.create", "params": {"name": "1", "end": "start", "modes": 1}},
    {"command": "model.port.create", "params": {"name": "2", "end": "end", "modes": 1}}
  ]}},
  {"click": "tab:SIMULATE"},
  {"click": "toolbar:study.optimize"},
  {"expect": {"dialog": "study.optimize", "handles": ["dialog:field:method"]}},
