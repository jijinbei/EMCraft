  {"until": {"busy": false, "view": "study"}, "timeout": 120},
  {"expect": {"status": "Bayesian, surrogate", "status_error": false, "inspect": {"study.kind": "optimize", "study.surrogate": true, "study.predicted": 0, "variables.l": {"min": 10.5, "max": 11.5}}}},
  {"frames": 3},
  {"shot": "study_surrogate_optimize"}
