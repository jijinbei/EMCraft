[
  {"note": "The step bar's looks say different things: a new project has things to do (hollow rings) and steps waiting on the geometry (grey), nothing red and nothing green that is not done"},
  {"call": "engine.execute", "params": {"command": "file.new"}},
  {"frames": 2},
  {"expect": {"inspect": {
    "workflow.steps.intent": "todo", "workflow.steps.geometry": "todo", "workflow.steps.materials": "waiting",
    "workflow.steps.excitation": "waiting", "workflow.steps.boundaries": "waiting", "workflow.steps.mesh": "waiting",
    "workflow.steps.setup": "waiting", "workflow.steps.run": "waiting", "workflow.steps.results": "waiting"}}},
  {"expect": {"inspect": {"workflow.messages.materials.0.text": "waits for the geometry: no bodies to give materials to yet", "workflow.messages.run.0.text": "waits for geometry, mesh"}}},
  {"shot": "status-new-project"},
  {"note": "The Materials step says it waits, its mark grey; the Run step names what it waits for"},
  {"click": "step:materials"},
  {"expect": {"inspect": {"workflow.step": "materials"}, "handles": ["step:fix:0"]}},
  {"shot": "status-materials-waiting"},
  {"call": "ui.set", "params": {"step": "none"}},
  {"note": "A sample with its geometry, mesh and ports: Run is to do (ready, not red), Results wait for it"},
  {"call": "engine.execute", "params": {"command": "file.sample", "params": {"name": "highpass"}}},
  {"frames": 2},
  {"expect": {"inspect": {
    "workflow.steps.geometry": "done", "workflow.steps.materials": "done", "workflow.steps.boundaries": "done", "workflow.steps.mesh": "done",
    "workflow.steps.intent": "todo", "workflow.steps.run": "todo", "workflow.steps.results": "waiting", "workflow.running": false}}},
  {"click": "step:run"},
  {"expect": {"handles": ["run:start"], "inspect": {"workflow.step": "run"}}},
  {"shot": "status-ready-to-run"},
  {"note": "A run that gives its frequencies without a band: afterwards no step is left asking for the band"},
  {"call": "engine.execute", "params": {"command": "solve.frequency", "params": {"start": 6.5, "stop": 8, "points": 2, "order": 1}}},
  {"until": {"busy": false, "inspect": {"model.results.frequencies": 2}}, "timeout": 120},
  {"expect": {"inspect": {"workflow.steps.intent": "done", "workflow.steps.setup": "done", "workflow.steps.run": "done", "workflow.steps.results": "done"}}},
  {"note": "A run that fails marks Run as needing attention, with why in its panel"},
  {"call": "ui.set", "params": {"step": "run"}},
  {"call": "engine.execute", "params": {"command": "solve.eigenmodes", "params": {"near": -5, "count": 1}}, "fail": true},
  {"frames": 2},
  {"expect": {"inspect": {"workflow.steps.run": "missing", "workflow.failure.command": "solve.eigenmodes"}}},
  {"shot": "status-run-failed"},
  {"note": "A run that works puts it right"},
  {"call": "engine.execute", "params": {"command": "solve.frequency", "params": {"start": 6.5, "stop": 8, "points": 2, "order": 1}}},
  {"until": {"busy": false}, "timeout": 120},
  {"expect": {"inspect": {"workflow.steps.run": "done"}}}
]
