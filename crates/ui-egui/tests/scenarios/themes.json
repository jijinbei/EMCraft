[
  {"note": "Themes: the built-in ones (light, dark and the one-hue ones) listed and switched by name (`dark` still a switch), unknown names refused, a reload; charts and field plots drawn in the theme's colours"},
  {"expect": {"inspect": {"theme": "light", "dark": false, "themes": ["light", "dark", "mono", "graphite", "sepia", "midnight", "forest"], "theme_problems": []}}},
  {"call": "engine.execute", "params": {"command": "file.sample", "params": {"name": "highpass"}}},
  {"call": "engine.execute", "params": {"command": "solve.frequency", "params": {"start": 6.6, "stop": 9, "points": 5, "order": 1}}},
  {"call": "ui.set", "params": {"view": "sparameters"}},
  {"frames": 3},
  {"expect": {"view": "sparameters", "handles": ["chart:sparameters"]}},
  {"shot": "theme-light-sparameters"},
  {"call": "ui.set", "params": {"theme": "dark"}},
  {"frames": 3},
  {"expect": {"inspect": {"theme": "dark", "dark": true}, "handles": ["chart:sparameters"]}},
  {"shot": "theme-dark-sparameters"},
  {"note": "The field plot, dark"},
  {"click": "chart:sparameters"},
  {"frames": 3},
  {"expect": {"view": "field"}},
  {"shot": "theme-dark-field"},
  {"note": "The one-hue themes: a light and a dark one, picked by name"},
  {"call": "ui.set", "params": {"theme": "sepia"}},
  {"frames": 3},
  {"expect": {"inspect": {"theme": "sepia", "dark": false}}},
  {"shot": "theme-sepia-field"},
  {"call": "ui.set", "params": {"theme": "midnight"}},
  {"frames": 3},
  {"expect": {"inspect": {"theme": "midnight", "dark": true}}},
  {"shot": "theme-midnight-field"},
  {"note": "Unknown or ill-typed themes are refused; nothing changes"},
  {"call": "ui.set", "params": {"theme": "paper"}, "fail": true},
  {"call": "ui.set", "params": {"theme": 3}, "fail": true},
  {"expect": {"inspect": {"theme": "midnight"}}},
  {"note": "The old switch, and a reload of the user's themes (the harness reads none)"},
  {"call": "ui.set", "params": {"dark": false, "reload_themes": true}},
  {"frames": 2},
  {"expect": {"inspect": {"theme": "light", "dark": false, "themes": ["light", "dark", "mono", "graphite", "sepia", "midnight", "forest"]}}},
  {"shot": "theme-light-field"},
  {"note": "The settings list every theme"},
  {"click": "bar:settings"},
  {"expect": {"handles": ["settings:theme:light", "settings:theme:dark", "settings:theme:mono", "settings:theme:forest"]}},
  {"click": "settings:theme:dark"},
  {"key": "Escape"},
  {"frames": 2},
  {"expect": {"inspect": {"theme": "dark", "dark": true}}},
  {"call": "ui.set", "params": {"view": "model"}},
  {"frames": 3},
  {"shot": "theme-dark-model"},
  {"call": "ui.set", "params": {"theme": "graphite"}},
  {"frames": 3},
  {"shot": "theme-graphite-model"},
  {"call": "ui.set", "params": {"theme": "mono"}},
  {"frames": 3},
  {"shot": "theme-mono-model"},
  {"call": "ui.set", "params": {"theme": "forest"}},
  {"frames": 3},
  {"shot": "theme-forest-model"}
]
