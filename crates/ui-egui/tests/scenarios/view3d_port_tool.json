[
  {"note": "Ports made by pointing at the model: the face port tool lights the face under the pointer; a click on a free end makes a port there"},
  {"call": "engine.execute", "params": {"command": "geometry.waveguide", "params": {"width": 22.86, "height": 10.16, "sections": [{"length": 30, "material": "vacuum"}]}}},
  {"call": "ui.set", "params": {"view": "model", "tab": "PORTS & SOURCES"}},
  {"click": "toolbar:tool:port"},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.tools.tool": "port", "workflow.step": "excitation", "view3d.overlay": "ports"}, "handles": ["view3d:end:start", "view3d:end:end", "step:tool:port"]}},
  {"call": "ui.set", "params": {"standard_view": "front"}},
  {"frames": 2},
  {"move": "view3d"},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.tools.pointer.port": "end"}}},
  {"shot": "port-hover"},
  {"click": "view3d"},
  {"frames": 2},
  {"expect": {"inspect": {"model.ports.0.name": "1", "model.ports.0.end": "end", "view3d.tools.tool": "port"}}},
  {"note": "The other end, from behind"},
  {"call": "ui.set", "params": {"standard_view": "back"}},
  {"frames": 2},
  {"move": "view3d"},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.tools.pointer.port": "start"}}},
  {"click": "view3d"},
  {"frames": 2},
  {"expect": {"inspect": {"model.ports.1.name": "2", "model.ports.1.end": "start"}}},
  {"note": "A port's own face selects it: its card offers Edit and Delete, and its reference plane shows with a grip"},
  {"move": {"handle": "view3d", "offset": [1, 1]}},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.tools.pointer.port": "existing"}}},
  {"click": {"handle": "view3d", "offset": [1, 1]}},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.selected": "Port(1)"}, "handles": ["view3d:selected:edit", "view3d:selected:delete", "view3d:refplane"]}},
  {"key": "Escape"},
  {"expect": {"inspect": {"view3d.tools.tool": null}}},
  {"call": "ui.set", "params": {"standard_view": "iso"}},
  {"frames": 2},
  {"shot": "port-selected"},
  {"note": "Dragging the grip moves the reference plane along the port's line, into the guide; letting go sets the de-embedding"},
  {"drag": ["view3d:refplane", {"handle": "view3d:refplane", "offset": [-80, 45]}]},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.tools.drag": null}, "query": {"command": "project.values", "params": {"command": "model.port.edit", "name": "2"}, "path": "deembed", "value": {"min": 2, "max": 20}}}},
  {"shot": "port-refplane"},
  {"note": "Edit opens the port's dialog on its values; Delete removes it"},
  {"click": "view3d:selected:edit"},
  {"expect": {"dialog": "model.port.edit", "inspect": {"dialog.fields.name": "2", "dialog.fields.end": "start"}}},
  {"click": "dialog:cancel"},
  {"click": "view3d:selected:delete"},
  {"frames": 2},
  {"expect": {"inspect": {"model.ports.1": null, "model.ports.0.name": "1", "view3d.selected": null}, "hidden": ["view3d:selected", "view3d:refplane"]}},
  {"note": "Inside an open box, a port goes on a body's face across z: the port dialog opens on that rectangle"},
  {"call": "engine.execute", "params": {"command": "file.new"}},
  {"call": "engine.script", "params": {"commands": [
    {"command": "geometry.solid", "params": {"shape": "box", "size": [40, 40, 40]}},
    {"command": "geometry.inclusion", "params": {"shape": "box", "size": [10, 8, 6], "at": [15, 16, 17]}},
    {"command": "model.open", "params": {"thickness": 5}}
  ]}},
  {"until": {"busy": false}},
  {"call": "ui.set", "params": {"tool": "port", "standard_view": "front"}},
  {"frames": 2},
  {"move": "view3d"},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.tools.pointer.port": "inside"}}},
  {"shot": "port-inside"},
  {"click": "view3d"},
  {"expect": {"dialog": "model.port.create", "inspect": {"dialog.fields.name": "1", "dialog.fields.end": "start", "dialog.fields.face": ["23", "15", "16", "10", "8"]}}},
  {"click": "dialog:cancel"},
  {"expect": {"dialog": null, "inspect": {"model.ports": []}}}
]
