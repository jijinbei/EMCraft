[
  {"note": "Tabs, command search (by name and as `command {json}`), docking a dialog, the dark theme"},
  {"click": "tab:MATERIALS"},
  {"expect": {"tab": "MATERIALS", "handles": ["toolbar:model.material.create", "toolbar:model.walls", "toolbar:model.open"], "hidden": ["toolbar:geometry.waveguide"]}},
  {"click": "tab:PORTS & SOURCES"},
  {"expect": {"handles": ["toolbar:model.port.create", "toolbar:model.port.lumped", "toolbar:source.dipole", "toolbar:source.plane_wave"]}},
  {"click": "tab:MESH"},
  {"expect": {"handles": ["toolbar:mesh.generate"]}},
  {"click": "search:field"},
  {"text": "lumped"},
  {"expect": {"handles": ["search:row:model.port.lumped"]}},
  {"shot": "search"},
  {"key": "Enter"},
  {"expect": {"dialog": "model.port.lumped", "inspect": {"search.open": false, "dialog.docked": false}}},
  {"click": "dialog:dock"},
  {"expect": {"inspect": {"dialog.docked": true, "dock_dialogs": true}}},
  {"shot": "docked-dialog"},
  {"click": "dialog:cancel"},
  {"expect": {"dialog": null}},
  {"click": "search:field"},
  {"text": "units.set {\"length\": \"m\"}"},
  {"key": "Enter"},
  {"expect": {"status": "Display units done", "inspect": {"model.units.length": "m"}}},
  {"click": "search:field"},
  {"text": "units.set {\"length\": "},
  {"key": "Enter"},
  {"expect": {"status_error": true, "status": "not JSON", "inspect": {"model.units.length": "m"}}},
  {"click": "bar:settings"},
  {"click": "settings:theme:dark"},
  {"key": "Escape"},
  {"expect": {"inspect": {"dark": true}}},
  {"call": "engine.execute", "params": {"command": "file.sample", "params": {"name": "iris-bandpass"}}},
  {"frames": 2},
  {"shot": "dark-model"}
]
