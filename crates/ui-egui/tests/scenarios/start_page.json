  {"frames": 2},
  {"expect": {"inspect": {"home": true}, "handles": ["home:new", "home:open", "sample:highpass", "sample:iris-bandpass", "sample:coupled-filter", "sample:coupler", "settings:length:mm", "home:settings"]}},
  {"shot": "start-page"},
  {"note": "New projects in metres and megahertz"},
  {"click": "settings:length:m"},
  {"click": "settings:frequency:MHz"},
  {"click": "home:new"},
  {"frames": 2},
  {"expect": {"inspect": {"home": false, "model.units.length": "m", "model.units.frequency": "MHz", "project.dirty": false, "project.title": "Untitled"}}},
  {"note": "A change, then a sample from the start page: the changes are asked about first"},
  {"call": "engine.execute", "params": {"command": "model.material.create", "params": {"name": "ptfe", "eps_r": 2.1}}},
  {"expect": {"inspect": {"project.dirty": true, "project.title": "Untitled •"}}},
  {"click": "bar:start"},
  {"click": "sample:highpass"},
  {"click": "template:open"},
  {"frames": 2},
  {"expect": {"inspect": {"files.confirm": true, "home": true}, "handles": ["confirm:save", "confirm:discard", "confirm:cancel"]}},
  {"shot": "start-page-confirm"},
  {"click": "confirm:cancel"},
  {"expect": {"inspect": {"files.confirm": false, "project.dirty": true}}},
  {"click": "sample:highpass"},
  {"click": "template:open"},
  {"click": "confirm:discard"},
  {"until": {"busy": false, "inspect": {"home": false, "project.name": "highpass", "project.dirty": false}}, "timeout": 60},
  {"shot": "after-sample"}
