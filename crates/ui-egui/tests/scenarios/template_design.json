[
  {"note": "Templates built from SolidCraft designs: the card draws the design at its parameters and again as they change (the taper's length, the horn's mouth)"},
  {"size": [1500, 1600]},
  {"click": "bar:start"},
  {"click": "home:purpose:frequency"},
  {"frames": 2},
  {"click": "sample:taper"},
  {"frames": 3},
  {"expect": {"inspect": {"template.name": "taper", "template.fields.l": "40", "template.preview": true, "template.error": null, "template.marks": 5}, "handles": ["template:field:a2", "template:field:l", "template:preview"]}},
  {"shot": "design-taper"},
  {"click": "template:field:l", "double": true},
  {"key": "A", "cmd": true},
  {"text": "15"},
  {"frames": 3},
  {"expect": {"inspect": {"template.fields.l": "15", "template.preview": true, "template.error": null}}},
  {"move": "template:field:l"},
  {"frames": 2},
  {"expect": {"inspect": {"template.active": "l"}, "handles": ["template:mark"]}},
  {"shot": "design-taper-short"},
  {"click": "template:cancel"},
  {"click": "home:purpose:radiation"},
  {"frames": 2},
  {"click": "sample:horn"},
  {"frames": 3},
  {"expect": {"inspect": {"template.name": "horn", "template.preview": true, "template.error": null}}},
  {"click": "template:field:A", "double": true},
  {"key": "A", "cmd": true},
  {"text": "60"},
  {"frames": 3},
  {"expect": {"inspect": {"template.fields.A": "60", "template.preview": true, "template.error": null}}},
  {"move": "template:field:A"},
  {"frames": 2},
  {"shot": "design-horn-wide"},
  {"click": "template:cancel"},
  {"expect": {"inspect": {"template": null, "home": true}}}
