[
  {"note": "What was built is edited and deleted from its browser row: a right-click menu (Edit, Delete, Show in 3D), a double-click to edit, Delete on the selected row; dialogs open on the model's own values"},
  {"call": "engine.execute", "params": {"command": "file.sample", "params": {"name": "highpass"}}},
  {"click": "row:material:ptfe-like", "button": "right"},
  {"frames": 2},
  {"expect": {"handles": ["row-menu:edit", "row-menu:delete", "row-menu:show"]}},
  {"frames": 12},
  {"shot": "row-menu"},
  {"note": "Edit opens on the material as it is; a new name renames it everywhere it is used"},
  {"click": "row-menu:edit"},
  {"expect": {"dialog": "model.material.edit", "inspect": {"dialog.fields.name": "ptfe-like", "dialog.fields.eps_r": "2", "dialog.fields.rename": ""}}},
  {"shot": "material-edit"},
  {"click": "dialog:field:rename"},
  {"text": "ptfe"},
  {"click": "dialog:ok"},
  {"expect": {"dialog": null, "inspect": {"model.materials.1.name": "ptfe", "model.waveguide.sections.0.material": "ptfe"}, "handles": ["row:material:ptfe", "row:section:1"]}},
  {"note": "A material in use cannot go: the refusal is an error message, nothing changes"},
  {"click": "row:material:ptfe", "button": "right"},
  {"click": "row-menu:delete"},
  {"expect": {"status_error": true, "status": "Delete material", "inspect": {"model.materials.1.name": "ptfe"}}},
  {"note": "Delete on a selected row deletes it; a port from its menu; undo brings it back"},
  {"call": "engine.execute", "params": {"command": "model.material.create", "params": {"name": "spare", "eps_r": 3}}},
  {"click": "row:material:spare"},
  {"key": "Delete"},
  {"expect": {"status_error": false, "inspect": {"model.materials.2": null}, "hidden": ["row:material:spare"]}},
  {"click": "row:port:2", "button": "right"},
  {"expect": {"handles": ["row-menu:edit", "row-menu:delete", "row-menu:show"]}},
  {"click": "row-menu:delete"},
  {"expect": {"inspect": {"model.ports.1": null}, "hidden": ["row:port:2"]}},
  {"key": "Z", "cmd": true},
  {"expect": {"inspect": {"model.ports.1.name": "2"}, "handles": ["row:port:2"]}},
  {"note": "Double-click edits: a port opens on its own values"},
  {"click": "row:port:1", "double": true},
  {"expect": {"dialog": "model.port.edit", "inspect": {"dialog.fields.name": "1", "dialog.fields.modes": "4", "dialog.fields.end": "start"}}},
  {"call": "ui.dialog", "params": {"set": {"modes": 2}, "ok": true}},
  {"expect": {"dialog": null, "inspect": {"model.ports.0.modes": 2}, "handles": ["row:port:1"]}},
  {"note": "A dialog opened on the model's values and left as it is runs nothing: the walls are perfect conductors"},
  {"click": "row:outer", "double": true},
  {"expect": {"dialog": "model.walls", "inspect": {"dialog.fields.conductivity": "", "dialog.fields.thickness": "1.27", "history": 16, "undo": 5}}},
  {"click": "dialog:ok"},
  {"expect": {"dialog": null, "inspect": {"history": 16, "undo": 5}, "handles": ["row:outer"]}}
]
