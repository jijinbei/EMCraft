[
 {
  "note": "Editing the board: a route's segment widened and deleted in the panel (undone), a via added from the ribbon's command"
 },
 {
  "call": "ui.set",
  "params": {
   "language": "ja"
  }
 },
 {
  "call": "engine.execute",
  "params": {
   "command": "pcb.sample",
   "params": {
    "split": false,
    "neighbour": false
   }
  }
 },
 {
  "call": "engine.execute",
  "params": {
   "command": "view.pcb",
   "params": {
    "net": "DATA",
    "stage": "net"
   }
  }
 },
 {
  "call": "ui.set",
  "params": {
   "view": "pcb"
  }
 },
 {
  "frames": 2
 },
 {
  "expect": {
   "handles": [
    "choice:pcb_width:signal:0",
    "choice:pcb_delete:signal:1"
   ]
  }
 },
 {
  "click": "choice:pcb_delete:signal:1"
 },
 {
  "frames": 2
 },
 {
  "expect": {
   "hidden": [
    "choice:pcb_delete:signal:1"
   ]
  }
 },
 {
  "key": "Z",
  "cmd": true
 },
 {
  "frames": 2
 },
 {
  "expect": {
   "handles": [
    "choice:pcb_delete:signal:1"
   ]
  }
 },
 {
  "call": "engine.execute",
  "params": {
   "command": "pcb.via",
   "params": {
    "net": "DATA",
    "at": [
     45,
     10
    ],
    "layers": [
     "F.Cu",
     "B.Cu"
    ],
    "diameter": 0.6
   }
  }
 },
 {
  "frames": 3
 },
 {
  "note": "Drawing the route on in 3D: two clicks on its layer add a segment from the route's end"
 },
 {
  "click": "choice:pcb_mode:draw"
 },
 {
  "call": "ui.set",
  "params": {
   "standard_view": "top"
  }
 },
 {
  "frames": 3
 },
 {
  "click": "choice:pcb_control:board3d"
 },
 {
  "frames": 1
 },
 {
  "click": {
   "handle": "choice:pcb_control:board3d",
   "offset": [
    60,
    40
   ]
  }
 },
 {
  "frames": 3
 },
 {
  "expect": {
   "handles": [
    "choice:pcb_width:edit:2"
   ]
  }
 },
 {
  "shot": "pcb-edit"
 }
]
