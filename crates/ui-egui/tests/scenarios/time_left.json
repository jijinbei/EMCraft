[
  {"note": "A run past its estimate never counts down to 0: a fast sweep (its full solves not known in advance) says its full solves and residual with the time run and an open bar; a counted sweep says the time left from its own rate"},
  {"call": "engine.execute", "params": {"command": "file.sample", "params": {"name": "highpass"}}},
  {"call": "engine.execute", "params": {"command": "solve.frequency", "params": {"start": 6, "stop": 9, "points": 400, "order": 2}, "wait": false}},
  {"until": {"inspect": {"progress.stage": "fast sweep", "progress.done": {"min": 2}, "progress.residual": "*"}}, "timeout": 120},
  {"note": "The test hook: an estimate long passed"},
  {"call": "ui.set", "params": {"job_estimate": 0.001}},
  {"frames": 2},
  {"expect": {"busy": true, "handles": ["bar:job", "status:cancel"], "inspect": {"progress.open": true, "progress.fraction": null, "progress.remaining": null, "progress.text": {"includes": "fast: ", "excludes": "left"}}}},
  {"shot": "time-left-fast-sweep"},
  {"call": "ui.set", "params": {"language": "ja"}},
  {"frames": 2},
  {"expect": {"inspect": {"progress.text": {"includes": "完全解", "excludes": "残り"}}}},
  {"shot": "time-left-fast-sweep-ja"},
  {"call": "ui.set", "params": {"language": "en"}},
  {"call": "ui.cancel", "params": {}},
  {"expect": {"busy": false}},
  {"note": "A counted sweep past its estimate: the time left from its own rate, never 0"},
  {"call": "engine.execute", "params": {"command": "solve.frequency", "params": {"start": 6.5, "stop": 9, "points": 400, "order": 2, "sweep": "full"}, "wait": false}},
  {"until": {"inspect": {"progress.stage": "frequency", "progress.done": {"min": 2}}}, "timeout": 120},
  {"call": "ui.set", "params": {"job_estimate": 0.001}},
  {"frames": 2},
  {"expect": {"inspect": {"progress.open": false, "progress.remaining": {"min": 1}, "progress.text": {"includes": " left", "excludes": "0.0 s left"}}}},
  {"note": "Bad estimates are refused, and so is one with no job"},
  {"call": "ui.set", "params": {"job_estimate": -1}, "fail": true},
  {"call": "ui.cancel", "params": {}},
  {"expect": {"busy": false}},
  {"call": "ui.set", "params": {"job_estimate": 5}, "fail": true}
]
