[
  {"note": "The analysis history: every solve kept; a chip over the S-parameter chart draws an earlier one over it, its menu restores it, pins it or lets it go"},
  {"call": "engine.execute", "params": {"command": "file.sample", "params": {"name": "highpass"}}},
  {"call": "engine.execute", "params": {"command": "solve.frequency", "params": {"start": 6.6, "stop": 9, "points": 9, "order": 1}}},
  {"call": "engine.execute", "params": {"command": "project.variable", "params": {"name": "l_gap", "value": 26}}},
  {"call": "engine.execute", "params": {"command": "solve.frequency", "params": {"start": 6.6, "stop": 9, "points": 9, "order": 1}}},
