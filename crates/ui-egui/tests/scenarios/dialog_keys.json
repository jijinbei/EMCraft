[
  {"note": "A dialog's Enter and Escape are its own only while its fields (or nothing) have the keyboard; a dialog opens with its first field ready to type in"},
  {"call": "engine.execute", "params": {"command": "file.sample", "params": {"name": "highpass"}}},
  {"call": "engine.execute", "params": {"command": "project.frequency", "params": {"start": 6, "stop": 9}}},
  {"call": "ui.set", "params": {"step": "intent"}},
  {"click": "toolbar:project.frequency"},
  {"expect": {"dialog": "project.frequency", "inspect": {"workflow.step": "intent", "dialog.fields.start": "6"}}},
  {"note": "The first field has the keyboard: typing replaces its text"},
  {"key": "A", "cmd": true},
  {"text": "6.5"},
  {"expect": {"inspect": {"dialog.fields.start": "6.5"}}},
  {"shot": "dialog-keys-first-field"},
  {"note": "Enter in the step panel's own field applies the band there; the dialog stays open, its typing kept"},
  {"click": "intent:stop"},
  {"key": "A", "cmd": true},
  {"text": "9.5"},
  {"key": "Enter"},
  {"expect": {"dialog": "project.frequency", "inspect": {"dialog.fields.start": "6.5"}}},
  {"note": "Escape in the step panel's field lets go of the field only"},
  {"click": "intent:stop"},
  {"key": "Escape"},
  {"expect": {"dialog": "project.frequency"}},
  {"note": "The question before changes are lost is over the dialog: Escape closes it, not the dialog"},
  {"click": "menu:file"},
  {"click": "file:new"},
  {"expect": {"inspect": {"files.confirm": true}}},
  {"key": "Escape"},
  {"expect": {"dialog": "project.frequency", "inspect": {"files.confirm": false, "dialog.fields.start": "6.5"}}},
  {"note": "The search over it too"},
  {"click": "search:field"},
  {"text": "mesh"},
  {"key": "Escape"},
  {"expect": {"dialog": "project.frequency", "inspect": {"search.open": false}}},
  {"note": "Enter in the dialog's own field is its OK"},
  {"click": "dialog:field:stop"},
  {"key": "A", "cmd": true},
  {"text": "8.5"},
  {"key": "Enter"},
  {"expect": {"dialog": null, "status": "Band 6.5 to 8.5"}},
  {"note": "Escape with the dialog's field in hand closes it, and the next Escape finds nothing to close"},
  {"click": "toolbar:project.frequency"},
  {"expect": {"dialog": "project.frequency"}},
  {"key": "Escape"},
  {"expect": {"dialog": null, "inspect": {"workflow.step": "intent"}}}
]
