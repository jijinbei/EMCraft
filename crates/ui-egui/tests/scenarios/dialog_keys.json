[
  {"note": "A dialog's Enter and Escape are its own only while its fields (or nothing) have the keyboard; a dialog opens with its first field ready to type in"},
  {"call": "engine.execute", "params": {"command": "file.sample", "params": {"name": "highpass"}}},
  {"call": "engine.execute", "params": {"command": "project.setup", "params": {"kind": "frequency", "start": 6, "stop": 9}}},
  {"call": "ui.set", "params": {"step": "setup"}},
  {"call": "ui.set", "params": {"tab": "BOUNDARIES"}},
  {"click": "toolbar:model.walls"},
  {"expect": {"dialog": "model.walls", "inspect": {"workflow.step": "setup", "dialog.fields.thickness": "1.27"}}},
  {"note": "The first field has the keyboard: typing replaces its text"},
  {"key": "A", "cmd": true},
  {"text": "5e7"},
  {"expect": {"inspect": {"dialog.fields.conductivity": "5e7"}}},
  {"shot": "dialog-keys-first-field"},
  {"note": "Enter in the step panel's own field applies it there; the dialog stays open, its typing kept"},
  {"click": "setup:points"},
  {"key": "A", "cmd": true},
  {"text": "11"},
  {"key": "Enter"},
  {"expect": {"dialog": "model.walls", "inspect": {"dialog.fields.conductivity": "5e7"}}},
  {"note": "Escape in the step panel's field lets go of the field only"},
  {"click": "setup:points"},
  {"key": "Escape"},
  {"expect": {"dialog": "model.walls"}},
  {"note": "The question before changes are lost is over the dialog: Escape closes it, not the dialog"},
  {"click": "menu:file"},
  {"click": "file:new"},
  {"expect": {"inspect": {"files.confirm": true}}},
  {"key": "Escape"},
  {"expect": {"dialog": "model.walls", "inspect": {"files.confirm": false, "dialog.fields.conductivity": "5e7"}}},
  {"note": "The search over it too"},
  {"click": "search:field"},
  {"text": "mesh"},
  {"key": "Escape"},
  {"expect": {"dialog": "model.walls", "inspect": {"search.open": false}}},
  {"note": "Enter in the dialog's own field is its OK"},
  {"click": "dialog:field:thickness"},
  {"key": "A", "cmd": true},
  {"text": "2"},
  {"key": "Enter"},
  {"expect": {"dialog": null, "query": {"command": "project.values", "params": {"command": "model.walls"}, "path": "thickness", "value": 2.0}}},
  {"note": "Escape with the dialog's field in hand closes it, and the next Escape finds nothing to close"},
  {"click": "toolbar:model.walls"},
  {"expect": {"dialog": "model.walls"}},
  {"key": "Escape"},
  {"expect": {"dialog": null, "inspect": {"workflow.step": "setup"}}}
]
