[
  {"note": "The 3D view cut open: the section switch in its tool bar, then the axis, where along it and which side stays; the cut faces are filled in each body's colour"},
  {"call": "engine.execute", "params": {"command": "file.sample", "params": {"name": "highpass"}}},
  {"call": "ui.set", "params": {"view": "model", "standard_view": "iso"}},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.section": null}, "handles": ["view3d:section"], "hidden": ["view3d:section:at"]}},
  {"click": "view3d:section"},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.section.axis": "x", "view3d.section.at": [11.43, 1e-9], "view3d.section.keep": "low"},
              "handles": ["view3d:section:x", "view3d:section:y", "view3d:section:z", "view3d:section:at", "view3d:section:flip"]}},
  {"shot": "section-highpass"},
  {"call": "ui.set", "params": {"dark": true}},
  {"frames": 2},
  {"shot": "section-highpass-dark"},
  {"call": "ui.set", "params": {"dark": false}},
  {"note": "The other side, another axis (its middle), a position set exactly"},
  {"click": "view3d:section:flip"},
  {"expect": {"inspect": {"view3d.section.keep": "high"}}},
  {"click": "view3d:section:z"},
  {"expect": {"inspect": {"view3d.section.axis": "z", "view3d.section.at": [25, 1e-9], "view3d.section.keep": "low"}}},
  {"call": "ui.set", "params": {"section": {"axis": "z", "at": 12.5, "keep": "high"}}},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.section.at": [12.5, 1e-9], "view3d.section.keep": "high"}}},
  {"note": "The slider moves the cut along the axis, within the model"},
  {"drag": ["view3d:section:at", {"handle": "view3d:section:at", "offset": [-200, 0]}]},
  {"expect": {"inspect": {"view3d.section.at": [0, 1e-9]}}},
  {"note": "Hostile requests are refused; nothing changes"},
  {"call": "ui.set", "params": {"section": {"axis": "w"}}, "fail": true},
  {"call": "ui.set", "params": {"section": {"axis": "x", "at": "far"}}, "fail": true},
  {"call": "ui.set", "params": {"section": {"axis": "x", "keep": "middle"}}, "fail": true},
  {"call": "ui.set", "params": {"section": {"axis": "x", "at": 1e300}}, "fail": true},
  {"expect": {"inspect": {"view3d.section.axis": "z"}}},
  {"note": "A post in a guide, cut across its length: the post and the guide's sections show their cut faces; a click on a cap picks its body"},
  {"call": "engine.execute", "params": {"command": "file.sample", "params": {"name": "inductive-post"}}},
  {"call": "ui.set", "params": {"view": "model", "standard_view": "iso", "section": {"axis": "z"}}},
  {"frames": 3},
  {"expect": {"inspect": {"view3d.section.axis": "z"}}},
  {"shot": "section-post"},
  {"call": "ui.set", "params": {"dark": true}},
  {"frames": 2},
  {"shot": "section-post-dark"},
  {"call": "ui.set", "params": {"dark": false}},
  {"call": "ui.set", "params": {"section": null}},
  {"frames": 2},
  {"expect": {"inspect": {"view3d.section": null}, "hidden": ["view3d:section:at"]}}
]
