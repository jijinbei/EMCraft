[
  {"note": "A sweep set up in its dialog by typing, run on the worker, its S-parameters charted"},
  {"call": "engine.execute", "params": {"command": "file.sample", "params": {"name": "highpass"}}},
  {"click": "tab:SIMULATE"},
  {"expect": {"tab": "SIMULATE", "handles": ["toolbar:solve.frequency", "toolbar:solve.eigenmodes", "toolbar:solve.time_domain", "toolbar:solve.port_modes"]}},
  {"click": "toolbar:solve.frequency"},
  {"expect": {"dialog": "solve.frequency"}},
  {"click": "dialog:field:start"},
  {"key": "A", "cmd": true},
  {"text": "6"},
  {"click": "dialog:field:stop"},
  {"key": "A", "cmd": true},
  {"text": "8"},
  {"click": "dialog:field:points"},
  {"key": "A", "cmd": true},
  {"text": "3"},
  {"click": "dialog:field:order"},
  {"key": "A", "cmd": true},
  {"text": "1"},
  {"expect": {"inspect": {"dialog.fields.points": "3", "dialog.fields.order": "1", "dialog.fields.start": "6"}}},
  {"click": "dialog:ok"},
  {"expect": {"dialog": null}},
  {"until": {"busy": false, "view": "sparameters"}, "timeout": 120},
  {"expect": {"status": "Solved 3 frequencies", "status_error": false, "inspect": {"model.results.frequencies": 3, "model.results.order": 1}}},
  {"frames": 3},
  {"expect": {"inspect": {"chart": "*"}, "handles": ["chart:sparameters", "row:Sweep: 3 frequencies, 3297 unknowns"]}},
  {"shot": "sparameters"},
  {"note": "Clicking the chart opens the fields at the nearest solved frequency"},
  {"click": "chart:sparameters"},
  {"expect": {"view": "field"}}
