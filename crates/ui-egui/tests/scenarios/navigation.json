[
  {"note": "3D view navigation as in SolidCraft: the view cube (faces, corners, quarter-turn arrows), Ctrl+1…7 and the arrow keys, the mouse mapping (default Fusion: middle pans, right orbits, Shift snaps; Ctrl+left orbits in every mapping), the wheel, pinch and two-finger pan, a mapping picked in Settings"},
  {"call": "engine.execute", "params": {"command": "file.sample", "params": {"name": "highpass"}}},
  {"call": "ui.set", "params": {"view": "model", "step": "none"}},
  {"frames": 2},
  {"expect": {"inspect": {"navigation.mapping": "fusion", "navigation.navigator": "cube", "navigation.orbit_around": "view_centre", "view3d.pitch": [35.264, 1e-3]}, "handles": ["view3d:cube", "view3d:cube:+x", "view3d:cube:+y", "view3d:cube:+z", "view3d:cube:+x+y+z", "view3d:std:front", "view3d:cube:home", "view3d:cube:fit", "view3d:cube:left"], "hidden": ["view3d:cube:-x", "view3d:std:back"]}},
  {"move": "view3d:cube"},
  {"frames": 2},
  {"shot": "nav-cube-iso"},
  {"note": "A face of the cube turns the view to it, animated; the view ends there"},
  {"click": "view3d:cube:+x"},
  {"expect": {"inspect": {"view3d.yaw": [90, 1e-6], "view3d.pitch": [0, 1e-6], "view3d.animating": false}, "handles": ["view3d:std:right"], "hidden": ["view3d:std:front"]}},
  {"shot": "nav-cube-right"},
  {"note": "The arrow right of the cube turns a quarter turn: from the right side round to the back"},
  {"click": "view3d:cube:right"},
  {"expect": {"inspect": {"view3d.yaw": [180, 1e-6], "view3d.pitch": [0, 1e-6]}}},
  {"note": "A corner looks along the cube's diagonal"},
  {"click": "view3d:cube:+x+y-z"},
  {"expect": {"inspect": {"view3d.yaw": [135, 1e-6], "view3d.pitch": [35.264, 1e-4]}}},
  {"shot": "nav-cube-corner"},
  {"click": "view3d:cube:home"},
  {"expect": {"inspect": {"view3d.yaw": [45, 1e-6], "view3d.pitch": [35.264, 1e-4]}}},
  {"note": "Ctrl+1…7: front, back, left, right, top, bottom, home"},
  {"key": "1", "cmd": true},
  {"expect": {"inspect": {"view3d.yaw": [0, 1e-9], "view3d.pitch": [0, 1e-9]}}},
  {"key": "4", "cmd": true},
  {"expect": {"inspect": {"view3d.yaw": [90, 1e-9], "view3d.pitch": [0, 1e-9]}}},
  {"key": "5", "cmd": true},
  {"expect": {"inspect": {"view3d.pitch": [90, 1e-9]}}},
  {"key": "7", "cmd": true},
  {"expect": {"inspect": {"view3d.yaw": [45, 1e-6], "view3d.pitch": [35.264, 1e-4]}}},
  {"note": "The arrows turn 15°, with Shift a quarter turn"},
  {"key": "1", "cmd": true},
  {"key": "ArrowRight"},
  {"expect": {"inspect": {"view3d.yaw": [15, 1e-6], "view3d.pitch": [0, 1e-6]}}},
  {"key": "ArrowRight"},
  {"key": "ArrowRight"},
  {"expect": {"inspect": {"view3d.yaw": [45, 1e-6]}}},
  {"key": "ArrowUp", "shift": true},
  {"expect": {"inspect": {"view3d.pitch": [90, 1e-6]}}},
  {"key": "ArrowDown", "shift": true},
  {"expect": {"inspect": {"view3d.pitch": [0, 1e-6]}}},
  {"note": "The default mapping: a middle drag pans, a right drag orbits (80 px: 36.7°), a plain left drag on empty space leaves the view"},
  {"key": "1", "cmd": true},
  {"drag": [{"handle": "view3d", "offset": [0, 0]}, {"handle": "view3d", "offset": [80, 0]}], "button": "middle"},
  {"expect": {"inspect": {"view3d.yaw": [0, 1e-9], "view3d.pitch": [0, 1e-9]}}},
  {"drag": [{"handle": "view3d", "offset": [300, 200]}, {"handle": "view3d", "offset": [380, 200]}]},
  {"expect": {"inspect": {"view3d.yaw": [0, 1e-9]}}},
  {"drag": [{"handle": "view3d", "offset": [0, 0]}, {"handle": "view3d", "offset": [80, 0]}], "button": "right"},
  {"expect": {"inspect": {"view3d.yaw": [323.33, 1e-4], "view3d.pitch": [0, 1e-9]}}},
  {"note": "Ctrl+left drag orbits in every mapping"},
  {"key": "1", "cmd": true},
  {"drag": [{"handle": "view3d", "offset": [0, 0]}, {"handle": "view3d", "offset": [-80, 0]}], "ctrl": true},
  {"expect": {"inspect": {"view3d.yaw": [36.67, 1e-3]}}},
  {"note": "Shift while orbiting snaps to the nearest of the cube's views"},
  {"key": "1", "cmd": true},
  {"drag": [{"handle": "view3d", "offset": [0, 0]}, {"handle": "view3d", "offset": [30, 12]}], "button": "right", "shift": true},
  {"expect": {"inspect": {"view3d.yaw": [0, 1e-9], "view3d.pitch": [0, 1e-9]}}},
  {"drag": [{"handle": "view3d", "offset": [0, 0]}, {"handle": "view3d", "offset": [-110, 0]}], "button": "right", "shift": true},
  {"expect": {"inspect": {"view3d.yaw": [45, 1e-9], "view3d.pitch": [0, 1e-9]}}},
  {"note": "The wheel zooms (e^(−0.0015) a point: three lines of 40 points), a pinch by its factor, a two-finger scroll pans"},
  {"key": "1", "cmd": true},
  {"call": "ui.set", "params": {"camera": {"distance": 0.2}}},
  {"call": "ui.scroll", "params": {"handle": "view3d", "delta": 3}},
  {"expect": {"inspect": {"view3d.distance": [0.167054, 1e-4]}}},
  {"call": "ui.scroll", "params": {"handle": "view3d", "zoom": 1.25}},
  {"expect": {"inspect": {"view3d.distance": [0.133643, 1e-4]}}},
  {"call": "ui.scroll", "params": {"handle": "view3d", "unit": "point", "pan": true, "dx": 40, "delta": 25}},
  {"expect": {"inspect": {"view3d.distance": [0.133643, 1e-4], "view3d.yaw": [0, 1e-9]}}},
  {"note": "Another mapping: Blender's middle drag orbits, its right drag leaves the view; picked on the settings page"},
  {"call": "ui.set", "params": {"settings": "3d"}},
  {"frames": 2},
  {"expect": {"handles": ["settings:navigation:fusion", "settings:navigation:blender", "settings:navigation:hfss", "settings:orbit_around:cursor", "settings:navigator:axes"]}},
  {"shot": "nav-settings"},
  {"click": "settings:navigation:blender"},
  {"expect": {"inspect": {"navigation.mapping": "blender"}}},
  {"call": "ui.set", "params": {"settings": "none"}},
  {"frames": 2},
  {"key": "1", "cmd": true},
  {"drag": [{"handle": "view3d", "offset": [0, 0]}, {"handle": "view3d", "offset": [80, 0]}], "button": "right"},
  {"expect": {"inspect": {"view3d.yaw": [0, 1e-9]}}},
  {"drag": [{"handle": "view3d", "offset": [0, 0]}, {"handle": "view3d", "offset": [80, 0]}], "button": "middle"},
  {"expect": {"inspect": {"view3d.yaw": [323.33, 1e-4]}}},
  {"call": "ui.set", "params": {"navigation": "nonsense"}, "fail": true},
  {"call": "ui.set", "params": {"orbit_around": "sideways"}, "fail": true},
  {"call": "ui.set", "params": {"navigation": "fusion", "navigator": "axes"}},
  {"expect": {"inspect": {"navigation.mapping": "fusion", "navigation.navigator": "axes"}, "handles": ["view3d:std:top", "view3d:std:back"], "hidden": ["view3d:cube"]}},
  {"shot": "nav-axes"}
]
