[
  {"note": "Which port is the input: the driven port (port 1 by default) is the input, its reflection S11; the others are outputs, the transmission to them S21. Rows keep their plain text as handles and show their symbols set as mathematics"},
  {"call": "engine.execute", "params": {"command": "file.sample", "params": {"name": "highpass"}}},
  {"until": {"busy": false}},
  {"call": "ui.set", "params": {"view": "model", "step": "excitation", "standard_view": "iso"}},
  {"frames": 3},
  {"expect": {"inspect": {"driven": "1", "ports.0.role": "input", "ports.0.s": "S11", "ports.1.role": "output", "ports.1.s": "S21", "view3d.overlay": "ports"},
    "handles": ["row:Port 1 (start): 4 modes", "row:Port 2 (end): 4 modes", "row:ptfe-like: εr 2, μr 1", "excitation:input:2"], "hidden": ["excitation:input:1"]}},
  {"shot": "roles-input-1"},
  {"note": "In Japanese: 入力 S₁₁ / 出力 S₂₁ on the rows, the handles the same"},
  {"call": "ui.set", "params": {"language": "ja"}},
  {"frames": 3},
  {"expect": {"handles": ["row:Port 1 (start): 4 modes", "excitation:input:2"]}},
  {"shot": "roles-ja"},
  {"call": "ui.set", "params": {"language": "en"}},
  {"frames": 2},
  {"note": "Port 2 made the input from the Excitation step: the roles, the S-parameters and the arrows swap"},
  {"click": "excitation:input:2"},
  {"frames": 3},
  {"expect": {"inspect": {"driven": "2", "ports.0.role": "output", "ports.0.s": "S12", "ports.1.role": "input", "ports.1.s": "S22"},
    "handles": ["excitation:input:1"], "hidden": ["excitation:input:2"]}},
  {"shot": "roles-input-2"},
  {"note": "Back from the row's menu: an output's menu makes it the input; the input's has no such item"},
  {"click": "row:Port 1 (start): 4 modes", "button": "right"},
  {"frames": 2},
  {"expect": {"handles": ["row-menu:drive", "row-menu:edit"]}},
  {"click": "row-menu:drive"},
  {"frames": 3},
  {"expect": {"inspect": {"driven": "1", "ports.0.role": "input", "ports.1.s": "S21"}}},
  {"click": "row:Port 1 (start): 4 modes", "button": "right"},
  {"frames": 2},
  {"expect": {"hidden": ["row-menu:drive"], "handles": ["row-menu:edit"]}},
  {"key": "Escape"},
  {"note": "The materials as typeset: ε with a lowered r, μ_r, tan δ"},
  {"call": "engine.execute", "params": {"command": "model.material.edit", "params": {"name": "ptfe-like", "loss_tangent": 0.001}}},
  {"call": "ui.set", "params": {"step": "materials"}},
  {"frames": 3},
  {"expect": {"handles": ["row:ptfe-like: εr 2, μr 1, tan δ 0.001"]}},
  {"shot": "materials-rich"},
  {"note": "The field view shows the driven port's excitation, and choosing another there drives it"},
  {"call": "engine.execute", "params": {"command": "solve.frequency", "params": {"start": 7, "stop": 8, "points": 2, "order": 1}}},
  {"until": {"busy": false}},
  {"click": "view:field"},
  {"frames": 2},
  {"expect": {"view": "field", "inspect": {"field.excitation": "1"}}},
  {"widget": "2"},
  {"frames": 3},
  {"expect": {"inspect": {"field.excitation": "2", "driven": "2", "ports.1.role": "input"}}},
  {"note": "A one-port: the single port is the input, its reflection S11"},
  {"call": "engine.execute", "params": {"command": "model.port.delete", "params": {"name": "1"}}},
  {"call": "ui.set", "params": {"view": "model", "step": "excitation"}},
  {"frames": 3},
  {"expect": {"inspect": {"driven": "2", "ports.0.name": "2", "ports.0.role": "input", "ports.0.s": "S11", "ports.1": null}}},
  {"shot": "one-port"}
]
